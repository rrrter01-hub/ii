-- ══════════════════════════════════════
--  SAFE ZONE DETECTION
--  วิธีเช็ค: หา part ชื่อ SafeZone / SpawnLocation
--  หรือเช็คว่า humanoid ถูก lock โดย ForceField
-- ══════════════════════════════════════
local safeZoneNames = {
    "SafeZone", "StartZone", "Safezone", "safe_zone",
    "SpawnLocation", "Town", "StartIsland"
}

local function isInSafeZone(player)
    local char = player.Character
    if not char then return false end

    -- วิธีที่ 1: มี ForceField = อยู่ใน safe zone
    if char:FindFirstChildOfClass("ForceField") then
        return true
    end

    -- วิธีที่ 2: เช็ค overlap กับ part ชื่อ SafeZone ใน workspace
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            for _, szName in ipairs(safeZoneNames) do
                if n == szName:lower() then
                    local dist = (root.Position - obj.Position).Magnitude
                    local size = obj.Size.Magnitude / 2
                    if dist < size + 5 then
                        return true
                    end
                end
            end
        end
    end
    return false
end

-- ══════════════════════════════════════
--  DISARMED CHECK
--  เช็คว่า player ไม่มี tool ถืออยู่ในมือ
-- ══════════════════════════════════════
local function isDisarmed(player)
    local char = player.Character
    if not char then return true end
    -- ถ้ามี Tool ใน character = ถืออยู่
    local tool = char:FindFirstChildOfClass("Tool")
    return tool == nil
end

-- ══════════════════════════════════════
--  UTILS
-- ══════════════════════════════════════
local function getRoot(p)
    local c = p.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function getHum(p)
    local c = p.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function isAlive(p)
    local h = getHum(p)
    return h and h.Health > 0
end
local function getBounty(p)
    local ls = p:FindFirstChild("leaderstats")
    if ls then
        local b = ls:FindFirstChild("Bounty") or ls:FindFirstChild("bounty")
        if b then return b.Value end
    end
    return 0
end

-- ══════════════════════════════════════
--  TARGET FINDER
-- ══════════════════════════════════════
local currentTarget = nil

local function findTarget()
    local myRoot = getRoot(LocalPlayer)
    if not myRoot then return nil end

    local best, bestVal = nil, nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if not isAlive(p) then continue end

        local bounty = getBounty(p)
        if bounty < CFG.minBounty then continue end

        -- Safe zone check
        if CFG.skipSafeZone and isInSafeZone(p) then continue end

        -- Disarmed check
        if CFG.onlyDisarmed and not isDisarmed(p) then continue end

        local r = getRoot(p)
        if not r then continue end

        local dist = (myRoot.Position - r.Position).Magnitude

        if CFG.targetMode == "nearest" then
            if not bestVal or dist < bestVal then
                best, bestVal = p, dist
            end
        elseif CFG.targetMode == "highest_bounty" then
            if not bestVal or bounty > bestVal then
                best, bestVal = p, bounty
            end
        end
    end
    return best
end

-- ══════════════════════════════════════
--  MOVEMENT — TP เข้าหาเป้า
-- ══════════════════════════════════════
local function moveTo(target)
    local myRoot  = getRoot(LocalPlayer)
    local tRoot   = getRoot(target)
    if not myRoot or not tRoot then return end

    local dist = (myRoot.Position - tRoot.Position).Magnitude
    if dist > CFG.safeStopDist + 1 then
        -- TP ไปข้างหน้าของเป้า offset เล็กน้อย
        local dir    = (myRoot.Position - tRoot.Position).Unit
        local newPos = tRoot.Position + dir * CFG.safeStopDist
        myRoot.CFrame = CFrame.new(newPos + Vector3.new(0, 2, 0),
                                   tRoot.Position)
    end
end

-- ══════════════════════════════════════
--  COMBAT — Real M1 via VirtualInput
--  ใช้ VirtualInputManager ให้ Roblox
--  รับ click จริง ไม่ใช่แค่ call function
-- ══════════════════════════════════════
local VIM = game:GetService("VirtualInputManager")

local comboStep  = 0
local lastHit    = 0
local skillQueue = {
    { key = Enum.KeyCode.Z, delay = 0.1 },
    { key = Enum.KeyCode.X, delay = 0.1 },
    { key = Enum.KeyCode.F, delay = 0.15 },
}

local function fireM1()
    VIM:SendMouseButtonEvent(0, 0, 0, true,  game, 1)
    task.wait(0.06)
    VIM:SendMouseButtonEvent(0, 0, 0, false, game, 1)
end

local function fireSkill(keyCode)
    VIM:SendKeyEvent(true,  keyCode, false, game)
    task.wait(0.05)
    VIM:SendKeyEvent(false, keyCode, false, game)
end

-- Look at target ก่อน attack
local function lookAt(target)
    local myRoot = getRoot(LocalPlayer)
    local tRoot  = getRoot(target)
    if not myRoot or not tRoot then return end
    myRoot.CFrame = CFrame.lookAt(myRoot.Position, tRoot.Position)
end

local function doAttack(target)
    local now = tick()
    if now - lastHit < CFG.comboDelay then return end
    lastHit = now

    lookAt(target)
    comboStep = comboStep + 1

    if comboStep <= 4 then
        -- M1 combo
        fireM1()
    elseif comboStep == 5 then
        fireSkill(skillQueue[1].key)
    elseif comboStep == 6 then
        fireSkill(skillQueue[2].key)
    elseif comboStep == 7 then
        fireSkill(skillQueue[3].key)
        comboStep = 0
    end
end

-- ══════════════════════════════════════
--  ESP SYSTEM
-- ══════════════════════════════════════
local espPool = {}

local function clearESP(p)
    if espPool[p] then
        pcall(function()
            if espPool[p].bb then espPool[p].bb:Destroy() end
            if espPool[p].line then espPool[p].line:Remove() end
        end)
        espPool[p] = nil
    end
end

local function buildESP(p)

-- [[ Blox Fruits Dedicated Single-Target Lock Engine v68 ]] --
-- Features: Finite State Machine (SEARCHING -> TRAVELING -> COMBAT), Anti-Jitter Lock, Sticky Back-Tracking

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local VirtualInputManager = game:GetService("VirtualInputManager")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")
local Humanoid = Character:WaitForChild("Humanoid")

-- [[ Configuration ]] --
local Config = {
    Enabled = false,
    FastAttack = true,
    AutoHaki = true,
    FlightSpeed = 320,
    CombatDistance = 3,       -- ระยะประชิดหลังเป้าหมาย (studs)
    CombatTimeout = 6,        -- เวลาสูงสุดถ้าตีเลือดไม่ลด (วินาที)
    SafeZoneGraceTime = 2.5,  -- ยอมให้เป้าหมายแตะขอบเซฟโซนได้ไม่เกินกี่วิ ก่อนเปลี่ยนตัว
    BlacklistTime = 25,       -- แบนตัวที่ตีไม่ได้กี่วินาที
    WeaponOrder = {"Melee", "Blox Fruit", "Sword", "Gun"},
    Skills = {"Z", "X", "C", "V"}
}

-- [[ FSM States ]] --
local States = {
    IDLE = "IDLE",
    SEARCHING = "SEARCHING",
    TRAVELING = "TRAVELING",
    COMBAT = "COMBAT"
}

local CurrentState = States.IDLE
local LockedTarget = nil
local Blacklist = {} -- [Player] = ExpireTime

-- Trackers
local CombatStartTime = 0
local LastRecordedHealth = nil
local SafeZoneTimer = 0
local ActiveTween = nil

-- Character Setup
LocalPlayer.CharacterAdded:Connect(function(char)
    Character = char
    RootPart = char:WaitForChild("HumanoidRootPart")
    Humanoid = char:WaitForChild("Humanoid")
    if ActiveTween then ActiveTween:Cancel() end
end)

-- [[ SafeZone Cache ]] --
local SafeZones = {}
local function UpdateSafeZones()
    table.clear(SafeZones)
    local worldOrigin = Workspace:FindFirstChild("_WorldOrigin")
    if worldOrigin and worldOrigin:FindFirstChild("SafeZones") then
        for _, z in ipairs(worldOrigin.SafeZones:GetChildren()) do
            if z:IsA("BasePart") then table.insert(SafeZones, z) end
        end
    end
end
UpdateSafeZones()

local function IsInSafeZone(position)
    for _, zone in ipairs(SafeZones) do
        if zone and zone.Parent then
            local rel = zone.CFrame:PointToObjectSpace(position)
            local half = zone.Size / 2
            if math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z then
                return true
            end
        end
    end
    return false
end

-- [[ Target Validation (Strict) ]] --
local function IsTargetEligible(player)
    if not player or player == LocalPlayer or not player.Parent then return false end
    if Blacklist[player] and tick() < Blacklist[player] then return false end

    local char = player.Character
    if not char then return false end
    
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return false end
    
    -- Safezone Shield / Forcefield
    if char:FindFirstChildOfClass("ForceField") or char:FindFirstChild("PvPDisabled") then 
        return false 
    end
    
    -- Check Position Safezone
    if IsInSafeZone(hrp.Position) then
        return false
    end
    
    return true
end

-- [[ Acquire ONE Single Nearest Target ]] --
local function FindSingleTarget()
    -- Clean Blacklist
    local now = tick()
    for p, expire in pairs(Blacklist) do
        if now >= expire then Blacklist[p] = nil end
    end

    local best = nil
    local minDist = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if IsTargetEligible(p) then
            local dist = (RootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
            if dist < minDist then
                minDist = dist
                best = p
            end
        end
    end
    return best
end

-- [[ Blacklist & Unlock ]] --
local function DropTarget(reason)
    if LockedTarget then
        Blacklist[LockedTarget] = tick() + Config.BlacklistTime
        print(string.format("[Hunter Lock] Dropped target '%s': %s", LockedTarget.Name, reason or "Unknown"))
    end
    LockedTarget = nil
    LastRecordedHealth = nil
    CombatStartTime = 0
    SafeZoneTimer = 0
    if ActiveTween then 
        ActiveTween:Cancel() 
        ActiveTween = nil 
    end
    CurrentState = States.SEARCHING
end

-- [[ Auto Haki ]] --
local function TriggerHaki()
    if not Config.AutoHaki or not Character then return end
    if not Character:FindFirstChild("HasBuso") then
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local commF = remotes and remotes:FindFirstChild("CommF_")
        if commF then
            commF:InvokeServer("Buso")
        end
    end
end

-- [[ Weapon Switch ]] --
local function EquipCategory(category)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack or not Character then return end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local toolType = tool:GetAttribute("WeaponType") or tool.ToolTip
            if toolType == category or tool.Name:lower():find(category:lower()) or (category == "Melee" and tool:FindFirstChild("CombatScript")) then
                Humanoid:EquipTool(tool)
                return
            end
        end
    end
end

-- [[ Fast Attack ]] --
local function AttackM1()
    if not Config.FastAttack then return end
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))
    
    local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
    if net and net:FindFirstChild("RegisterAttack") then
        net.RegisterAttack:FireServer(0)
    end
end

-- [[ Smooth Continuous Tracker (No Spamming Tweens) ]] --
local function UpdateFlightMovement(targetHRP)
    -- Anti-Collide
    for _, part in ipairs(Character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.Velocity = Vector3.new(0, 0, 0)
        end
    end

    -- Stick directly behind target
    local targetPos = targetHRP.CFrame * CFrame.new(0, 0, Config.CombatDistance)
    local dist = (RootPart.Position - targetPos.Position).Magnitude

    if dist > 80 then
        -- Fast Linear Tween for long distance traveling
        if not ActiveTween then
            local time = dist / Config.FlightSpeed
            ActiveTween = TweenService:Create(RootPart, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = targetPos})
            ActiveTween:Play()
            ActiveTween.Completed:Connect(function()
                ActiveTween = nil
            end)
        end
    else
        -- Close range instant lock-on (no tween delay)
        if ActiveTween then 
            ActiveTween:Cancel() 
            ActiveTween = nil 
        end
        RootPart.CFrame = targetPos
    end
end

-- [[ Dedicated Combat Execution ]] --
local function PerformCombatCycle(targetChar)
    local tHRP = targetChar:FindFirstChild("HumanoidRootPart")
    local tHum = targetChar:FindFirstChild("Humanoid")
    if not tHRP or not tHum or tHum.Health <= 0 then return end

    TriggerHaki()

    -- Look at Target
    RootPart.CFrame = CFrame.new(RootPart.Position, tHRP.Position)

    for _, cat in ipairs(Config.WeaponOrder) do
        if not Config.Enabled or not LockedTarget or tHum.Health <= 0 then break end
        
        EquipCategory(cat)
        task.wait(0.05)

        -- Rapid M1 Hits
        for i = 1, 3 do
            AttackM1()
            task.wait(0.04)
        end

        -- Cast Skill Sequence
        for _, skill in ipairs(Config.Skills) do
            if not LockedTarget or tHum.Health <= 0 then break end
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[skill], false, game)
            task.wait(0.08)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[skill], false, game)
            task.wait(0.18)
        end
    end
end

-- [[ Master State Machine Loop ]] --
task.spawn(function()
    while true do
        task.wait(0.03)

        if Config.Enabled then
            -- STATE 1: SEARCHING FOR TARGET
            if CurrentState == States.SEARCHING or not LockedTarget then
                LockedTarget = FindSingleTarget()
                if LockedTarget then
                    CurrentState = States.TRAVELING
                    CombatStartTime = tick()
                    LastRecordedHealth = LockedTarget.Character and LockedTarget.Character:FindFirstChild("Humanoid") and LockedTarget.Character.Humanoid.Health or nil
                    print(string.format("[Hunter Lock] >>> LOCKED ON: %s <<<", LockedTarget.Name))
                else
                    CurrentState = States.SEARCHING
                end

            -- STATE 2 & 3: TRAVELING & COMBAT ON THE SAME TARGET
            elseif LockedTarget then
                local char = LockedTarget.Character
                local hum = char and char:FindFirstChild("Humanoid")
                local hrp = char and char:FindFirstChild("HumanoidRootPart")

                -- Condition Check: Target Dead?
                if not char or not hum or hum.Health <= 0 or not hrp then
                    DropTarget("Target Defeated / Dead")
                    
                -- Condition Check: Target Inside SafeZone?
                elseif IsInSafeZone(hrp.Position) or char:FindFirstChildOfClass("ForceField") then
                    if SafeZoneTimer == 0 then
                        SafeZoneTimer = tick()
                    elseif tick() - SafeZoneTimer > Config.SafeZoneGraceTime then
                        DropTarget("Target Stayed in SafeZone")
                    end
                else
                    SafeZoneTimer = 0 -- Reset safezone counter if out in open
                    
                    -- Move / Stick to Target
                    UpdateFlightMovement(hrp)

                    local dist = (RootPart.Position - hrp.Position).Magnitude
                    if dist <= 20 then
                        CurrentState = States.COMBAT
                        
                        -- Anti-Invulnerable / Stall Timeout Check
                        if LastRecordedHealth and (tick() - CombatStartTime > Config.CombatTimeout) then
                            if hum.Health >= LastRecordedHealth then
                                DropTarget("Damage not registering (Invulnerable / Glitched)")
                            else
                                LastRecordedHealth = hum.Health
                                CombatStartTime = tick()
                            end
                        end
                        
                        PerformCombatCycle(char)
                    else
                        CurrentState = States.TRAVELING
                    end
                end
            end
        else
            CurrentState = States.IDLE
            if ActiveTween then 
                ActiveTween:Cancel() 
                ActiveTween = nil 
            end
        end
    end
end)

-- [[ Minimalist Clean Control UI ]] --

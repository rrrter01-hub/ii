-- [[ Blox Fruits Overhead Bounty Hunter v73 ]] --
-- Architecture: Strict Round-Robin Player Queue (All 12 Players), Zero Obstacle Direct Flight, 0.8s Damage Probe & Skip

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local VirtualInputManager = game:GetService("VirtualInputManager")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")
local Humanoid = Character:WaitForChild("Humanoid")

-- [[ Master Configuration ]] --
local Config = {
    Enabled = false,
    OverheadDistance = 11,
    FlySpeed = 420,
    FastAttack = true,
    AutoHaki = true,
    AutoPvP = true,
    SkillSpam = true,
    Skills = {"Z", "X", "C", "V"},
    Weapons = {"Melee", "Sword", "Blox Fruit", "Gun"},
    WeaponSwitchDelay = 0.6,
    DamageTestTime = 0.8      -- ตี 0.8 วิ ถ้าเลือดไม่ลดเลย = ข้ามไปหาคนถัดไปทันที
}

local CurrentTarget = nil
local BodyVel = nil
local CombatFramework = nil
local ActiveController = nil
local LastWeaponSwitch = 0
local CurrentWeaponIndex = 1

-- [[ 12-Player Round-Robin Queue Engine ]] --
local TargetQueue = {}
local QueueIndex = 1
local TriedPlayers = {} -- รายชื่อคนที่ลองไปแล้วในรอบนี้
local ProbeStartTime = 0
local ProbeStartHP = 0
local IsProbingDamage = false

-- [[ Remotes ]] --
local Remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
local CommF = Remotes and Remotes:WaitForChild("CommF_", 5)
local NetModule = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
local RegisterAttack = NetModule and (NetModule:FindFirstChild("RegisterAttack") or NetModule:FindFirstChild("RE/RegisterAttack"))
local RegisterHit = NetModule and (NetModule:FindFirstChild("RegisterHit") or NetModule:FindFirstChild("RE/RegisterHit"))

-- [[ Physics Anchor ]] --
local function EnsurePhysicsAnchor()
    if not RootPart then return end
    if not BodyVel or BodyVel.Parent ~= RootPart then
        if BodyVel then BodyVel:Destroy() end
        BodyVel = Instance.new("BodyVelocity")
        BodyVel.Name = "OnyxAnchor"
        BodyVel.Velocity = Vector3.new(0, 0, 0)
        BodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        BodyVel.P = 3000
        BodyVel.Parent = RootPart
    end
end

local function RemovePhysicsAnchor()
    if BodyVel then
        BodyVel:Destroy()
        BodyVel = nil
    end
end

-- [[ Stepped Noclip ]] --
RunService.Stepped:Connect(function()
    if Config.Enabled and Character then
        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        if RootPart then
            RootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            RootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end
end)

LocalPlayer.CharacterAdded:Connect(function(char)
    Character = char
    RootPart = char:WaitForChild("HumanoidRootPart")
    Humanoid = char:WaitForChild("Humanoid")
    task.wait(0.5)
    EnsurePhysicsAnchor()
    SetupCombatHooks()
end)

function SetupCombatHooks()
    pcall(function()
        local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
        if playerScripts and playerScripts:FindFirstChild("CombatFramework") then
            CombatFramework = require(playerScripts.CombatFramework)
            ActiveController = CombatFramework.activeController
        end
    end)
end
SetupCombatHooks()

-- [[ Auto Enable PvP & Buso Haki ]] --
local function EnsurePvPAndHaki()
    if not Character then return end
    pcall(function()
        if Config.AutoPvP and CommF then
            if Character:FindFirstChild("PvPDisabled") then
                CommF:InvokeServer("EnablePvp")
            end
        end
        if Config.AutoHaki and CommF then
            if not Character:FindFirstChild("HasBuso") then
                CommF:InvokeServer("Buso")
            end
        end
    end)
end

-- [[ Refresh 12-Player Queue ]] --
local function RefreshPlayerQueue()
    TargetQueue = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(TargetQueue, p)
        end
    end
    QueueIndex = 1
end

-- [[ Get Next Target from Queue (Round-Robin) ]] --
local function GetNextTargetFromQueue()
    if #TargetQueue == 0 or QueueIndex > #TargetQueue then
        -- ถ้าลองครบทุกคนในเซิร์ฟแล้ว รีเซ็ตรายชื่อแล้ววนรอบใหม่
        RefreshPlayerQueue()
        TriedPlayers = {}
    end

    local candidate = nil
    while QueueIndex <= #TargetQueue do
        local p = TargetQueue[QueueIndex]
        QueueIndex = QueueIndex + 1

        -- เช็คว่าตัวละครอยู่ในเกมและยังมีชีวิตอยู่
        if p and p.Parent and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
            if p.Character.Humanoid.Health > 0 and not TriedPlayers[p.UserId] then
                candidate = p
                break
            end
        end
    end

    -- ถ้าหาในคิวปัจจุบันไม่เจอ ให้รีเซ็ตคิวทันที
    if not candidate then
        RefreshPlayerQueue()
        TriedPlayers = {}
        if #TargetQueue > 0 then
            candidate = TargetQueue[1]
            QueueIndex = 2
        end
    end

    return candidate
end

-- [[ Weapon Switcher ]] --
local function SwitchWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack or not Character or not Humanoid then return end

    local category = Config.Weapons[CurrentWeaponIndex]
    local targetTool = nil

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local tType = tool:GetAttribute("WeaponType") or tool.ToolTip
            if tType == category or tool.Name:lower():find(category:lower()) or (category == "Melee" and (tool:FindFirstChild("CombatScript") or tool.ToolTip == "Melee")) then
                targetTool = tool
                break
            end
        end
    end

    if targetTool then
        Humanoid:EquipTool(targetTool)
    end

    CurrentWeaponIndex = (CurrentWeaponIndex % #Config.Weapons) + 1
end

-- [[ Fast Attack Engine ]] --
local function ExecuteFastAttack(targetHRP)
    if not Config.FastAttack or not targetHRP then return end

    pcall(function()
        if not ActiveController then SetupCombatHooks() end
        if ActiveController then
            ActiveController.timeToNextAttack = 0
            ActiveController.attacking = false
            ActiveController.blocking = false
            ActiveController.hitboxMagnitude = 100
            ActiveController.increment = 3
            if ActiveController.attack then ActiveController:attack() end
            if ActiveController.bladeHit then ActiveController.bladeHit(targetHRP, {targetHRP}) end
        end
    end)

    pcall(function()
        if RegisterAttack then RegisterAttack:FireServer(0) end
        if RegisterHit then RegisterHit:FireServer(targetHRP, {{targetHRP.Parent, targetHRP}}) end
    end)

    local currentTool = Character:FindFirstChildOfClass("Tool")
    if currentTool then currentTool:Activate() end
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))
end

-- [[ Skill Cast Engine ]] --
local function CastSkills(targetHRP, targetHum)
    if not Config.SkillSpam or not targetHRP or targetHum.Health <= 0 then return end
    pcall(function()
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHRP.Position)
    end)

    for _, key in ipairs(Config.Skills) do
        if not CurrentTarget or targetHum.Health <= 0 then break end
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
        task.wait(0.02)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
        task.wait(0.04)
    end
end

-- [[ Direct Missile Flight (Pure Vector - Zero Delay) ]] --
local function FlyDirectToTarget(targetHRP)
    EnsurePhysicsAnchor()
    local targetPos = targetHRP.Position + Vector3.new(0, Config.OverheadDistance, 0)
    local targetCF = CFrame.new(targetPos, targetHRP.Position) * CFrame.Angles(math.rad(-90), 0, 0)
    
    local curPos = RootPart.Position
    local dist = (curPos - targetPos).Magnitude

    if dist > 25 then
        local step = math.clamp((Config.FlySpeed * 0.02) / dist, 0, 1)
        RootPart.CFrame = CFrame.new(curPos:Lerp(targetPos, step), targetHRP.Position)
    else
        RootPart.CFrame = targetCF
    end
end

-- [[ Master Queue & Execution Loop ]] --
task.spawn(function()
    while true do
        task.wait(0.015)
        
        if Config.Enabled then
            EnsurePvPAndHaki()

            -- ตรวจสอบเป้าหมายปัจจุบัน
            if not CurrentTarget 
                or not CurrentTarget.Parent 
                or not CurrentTarget.Character 
                or not CurrentTarget.Character:FindFirstChild("HumanoidRootPart") 
                or not CurrentTarget.Character:FindFirstChild("Humanoid")
                or CurrentTarget.Character.Humanoid.Health <= 0 then
                
                CurrentTarget = GetNextTargetFromQueue()
                IsProbingDamage = false
                ProbeStartTime = 0
                ProbeStartHP = 0
            end

            if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
                local tHRP = CurrentTarget.Character.HumanoidRootPart
                local tHum = CurrentTarget.Character.Humanoid

                -- บินพุ่งตรงปักหัวเป้าหมายทันที
                FlyDirectToTarget(tHRP)

                local dist = (RootPart.Position - tHRP.Position).Magnitude

                -- เมื่อถึงระยะเหนือหัว (11 + 15 studs)
                if dist <= (Config.OverheadDistance + 15) then
                    -- เริ่มนับเวลาทดสอบดาเมจ (Damage Probe)
                    if not IsProbingDamage then
                        IsProbingDamage = true
                        ProbeStartTime = tick()
                        ProbeStartHP = tHum.Health
                    else
                        -- ครบ 0.8 วินาทีแล้ว
                        if (tick() - ProbeStartTime) >= Config.DamageTestTime then
                            if tHum.Health >= ProbeStartHP then
                                -- ตีไม่เข้า (เซฟโซน / ไม่เปิด PvP) -> จำชื่อใส่คิว แล้วสลับไปคนถัดไปทันที
                                TriedPlayers[CurrentTarget.UserId] = true
                                CurrentTarget = nil
                                IsProbingDamage = false
                            else
                                -- ตีเข้าปกติ ทำการล่าต่อไปจนกว่าจะตาย
                                ProbeStartTime = tick()
                                ProbeStartHP = tHum.Health
                            end
                        end
                    end

                    -- ทำการโจมตี
                    if CurrentTarget then
                        if tick() - LastWeaponSwitch >= Config.WeaponSwitchDelay then
                            SwitchWeapon()
                            LastWeaponSwitch = tick()
                        end

                        ExecuteFastAttack(tHRP)
                        CastSkills(tHRP, tHum)
                    end
                else
                    -- ยังบินไปไม่ถึงตัว ไม่นับเวลา timeout
                    IsProbingDamage = false
                end
            end
        else
            RemovePhysicsAnchor()
            CurrentTarget = nil
            IsProbingDamage = false
        end
    end
end)


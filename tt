-- [[ Force Enable PvP & Auto Haki ]] --
local function CheckPvPAndHaki()
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local commF = remotes and remotes:FindFirstChild("CommF_")
        if commF then
            if Config.AutoPvP then
                commF:InvokeServer("EnablePvP")
                commF:InvokeServer("PvP", true)
            end
            if Config.AutoHaki and Character and not Character:FindFirstChild("HasBuso") then
                commF:InvokeServer("Buso")
            end
        end
    end)
end

-- [[ Target Selector ]] --
local function GetNearestValidTarget()
    local now = tick()
    for p, exp in pairs(Blacklist) do
        if now >= exp then Blacklist[p] = nil end
    end

    local best = nil
    local minDist = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if IsValidTarget(p) then
            local dist = (RootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
            if dist < minDist then
                minDist = dist
                best = p
            end
        end
    end
    return best
end

-- [[ Equip Weapon ]] --
local function AutoEquipWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack or not Character then return end

    if not Character:FindFirstChildOfClass("Tool") then
        for _, category in ipairs(Config.Weapons) do
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then
                    local tType = tool:GetAttribute("WeaponType") or tool.ToolTip
                    if tType == category or tool.Name:lower():find(category:lower()) or (category == "Melee" and tool:FindFirstChild("CombatScript")) then
                        Humanoid:EquipTool(tool)
                        return
                    end
                end
            end
        end
    end
end

-- [[ Fast Attack M1 ]] --
local function AttackM1()
    if not Config.FastAttack then return end

    if ActiveController and ActiveController.attack then
        pcall(function()
            ActiveController.timeToNextAttack = 0
            ActiveController.hitboxMagnitude = 80 -- ขยายฮิตบ็อกซ์ให้ฟันถึงตัว 100%
            ActiveController:attack()
        end)
    end

    local tool = Character:FindFirstChildOfClass("Tool")
    if tool then tool:Activate() end

    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))

    local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
    if net and net:FindFirstChild("RegisterAttack") then
        net.RegisterAttack:FireServer(0)
    end
end

-- [[ AimLock ]] --
local function AimLock(pos)
    Camera.CFrame = CFrame.new(Camera.CFrame.Position, pos)
end

-- [[ THREAD 1: Continuous M1 Fast Attack ]] --
task.spawn(function()
    while true do
        task.wait(0.02)
        if Config.Enabled and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
            local tHRP = CurrentTarget.Character.HumanoidRootPart
            if (RootPart.Position - tHRP.Position).Magnitude <= (Config.OverheadDistance + 8) then
                AutoEquipWeapon()
                AttackM1()
            end
        end
    end
end)

-- [[ THREAD 2: Parallel Skills Aimlock ]] --
task.spawn(function()
    while true do
        task.wait(0.08)
        if Config.Enabled and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
            local tHRP = CurrentTarget.Character.HumanoidRootPart
            local tHum = CurrentTarget.Character:FindFirstChild("Humanoid")

            if (RootPart.Position - tHRP.Position).Magnitude <= (Config.OverheadDistance + 8) and tHum and tHum.Health > 0 then
                for _, key in ipairs(Config.Skills) do
                    if not Config.Enabled or not CurrentTarget or tHum.Health <= 0 then break end
                    AimLock(tHRP.Position)
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
                    task.wait(0.04)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
                    task.wait(0.12)
                end
            end
        end
    end
end)

-- [[ THREAD 3: Movement & In-Range Damage Watchdog ]] --
task.spawn(function()
    while true do
        task.wait(0.02)

        if Config.Enabled then
            CheckPvPAndHaki()

            -- 1. Acquire Target if None
            if not CurrentTarget or not IsValidTarget(CurrentTarget) then
                if CurrentTarget then
                    DropTarget("Entered SafeZone or PvP Disabled")
                end
                CurrentTarget = GetNearestValidTarget()
                InCombatRange = false
                CombatStartTimestamp = 0
                RecordedTargetHealth = nil
            end

            -- 2. Follow & Attack Loop
            if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
                local tHRP = CurrentTarget.Character.HumanoidRootPart
                local tHum = CurrentTarget.Character:FindFirstChild("Humanoid")

                -- Real-time SafeZone Check
                if IsInSafeZone(tHRP.Position) then
                    DropTarget("Target inside SafeZone")
                else
                    MaintainAnchor()

                    -- Direct Overhead Position (Y + 8 studs, มองตรงไปที่เป้าหมาย)
                    local overheadCFrame = CFrame.new(tHRP.Position + Vector3.new(0, Config.OverheadDistance, 0), tHRP.Position)
                    local curPos = RootPart.Position
                    local targetPos = overheadCFrame.Position
                    local dist = (curPos - targetPos).Magnitude

                    if dist > 80 then
                        -- Flight Phase: เคลื่อนที่เข้าหา
                        RootPart.CFrame = CFrame.new(curPos:Lerp(targetPos, (Config.FlySpeed * 0.02) / dist), tHRP.Position)
                        InCombatRange = false
                    else
                        -- In Range Phase: เกาะหัวเป้าหมาย
                        RootPart.CFrame = overheadCFrame

                        -- เริ่มจับเวลาดาเมจก็ต่อเมื่อบินถึงหัวแล้วเท่านั้น!
                        if not InCombatRange then
                            InCombatRange = true
                            CombatStartTimestamp = tick()
                            RecordedTargetHealth = tHum.Health
                        else
                            -- ตรวจสอบว่าตี 1.5 วิ แล้วเลือดลดไหม
                            if tick() - CombatStartTimestamp >= Config.DamageTimeout then
                                if tHum.Health >= RecordedTargetHealth then
                                    -- เลือดไม่ลด = SafeZone / อมเลือด -> ดีดทิ้งทันที!
                                    DropTarget("Zero Damage Registered in 1.5s (SafeZone/Invincible)")
                                else
                                    -- เลือดลดปกติ = ตีเข้า! อัปเดตเลือดล่าสุดแล้วล่าต่อ
                                    RecordedTargetHealth = tHum.Health
                                    CombatStartTimestamp = tick()
                                end
                            end
                        end
                    end
                end
            end
        else
            ClearAnchor()
        end
    end
end)


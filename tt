    local char = p.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- BillboardGui
    local bb = Instance.new("BillboardGui")
    bb.Name           = "PBH_ESP"
    bb.AlwaysOnTop    = true
    bb.Size           = UDim2.new(0, 80, 0, 100)
    bb.StudsOffset    = Vector3.new(0, 3.5, 0)
    bb.Adornee        = root
    bb.Parent         = game.CoreGui
    bb.ResetOnSpawn   = false

    -- Box outline
    local box = Instance.new("Frame", bb)
    box.Size              = UDim2.new(1,0,1,0)
    box.BackgroundTransparency = 1
    box.BorderSizePixel   = 2
    box.BorderColor3      = Color3.fromRGB(255, 50, 50)

    -- Name
    local nameLbl = Instance.new("TextLabel", bb)
    nameLbl.Size              = UDim2.new(1,0,0,18)
    nameLbl.Position          = UDim2.new(0,0,-0.22,0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text              = p.Name
    nameLbl.TextColor3        = Color3.fromRGB(255, 255, 80)
    nameLbl.Font              = Enum.Font.GothamBold
    nameLbl.TextScaled        = true

    -- Info (bounty + status)
    local infoLbl = Instance.new("TextLabel", bb)
    infoLbl.Size              = UDim2.new(1,0,0,14)
    infoLbl.Position          = UDim2.new(0,0,1.05,0)
    infoLbl.BackgroundTransparency = 1
    infoLbl.Font              = Enum.Font.Gotham
    infoLbl.TextScaled        = true
    infoLbl.TextColor3        = Color3.fromRGB(80, 255, 120)

    -- HP bar BG
    local hpBg = Instance.new("Frame", bb)
    hpBg.Size             = UDim2.new(0.1,0,1,0)
    hpBg.Position         = UDim2.new(-0.14,0,0,0)
    hpBg.BackgroundColor3 = Color3.fromRGB(40,40,40)
    hpBg.BorderSizePixel  = 0
    Instance.new("UICorner", hpBg).CornerRadius = UDim.new(0,2)

    local hpFill = Instance.new("Frame", hpBg)
    hpFill.Size           = UDim2.new(1,0,1,0)
    hpFill.AnchorPoint    = Vector2.new(0,1)
    hpFill.Position       = UDim2.new(0,0,1,0)
    hpFill.BackgroundColor3 = Color3.fromRGB(50,220,80)
    hpFill.BorderSizePixel = 0
    Instance.new("UICorner", hpFill).CornerRadius = UDim.new(0,2)

    -- Tracer (Drawing API)
    local line = Drawing.new("Line")
    line.Color       = Color3.fromRGB(255, 100, 200)
    line.Thickness   = 1
    line.Transparency = 0.4
    line.Visible     = true

    espPool[p] = { bb=bb, infoLbl=infoLbl, hpFill=hpFill, line=line, box=box }
end

local function updateESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end

        if not CFG.esp then
            clearESP(p)
            continue
        end

        if CFG.showOnlyTarget and p ~= currentTarget then
            clearESP(p)
            continue
        end

        local char = p.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")

        if not root or not hum then
            clearESP(p)
            continue
        end

        if not espPool[p] then buildESP(p) end
        local obj = espPool[p]
        if not obj then continue end

        -- Update bb adornee
        obj.bb.Adornee = root

        -- HP bar
        local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
        obj.hpFill.Size = UDim2.new(1, 0, pct, 0)
        obj.hpFill.BackgroundColor3 = Color3.fromRGB(
            math.floor((1-pct)*255), math.floor(pct*200), 40
        )

        -- Info label
        local myRoot = getRoot(LocalPlayer)
        local dist   = myRoot and math.floor((myRoot.Position - root.Position).Magnitude) or 0
        local szTag  = isInSafeZone(p) and "🛡SZ" or ""
        local disTag = isDisarmed(p) and "🔓" or "🔫"
        local bounty = getBounty(p)
        obj.infoLbl.Text = string.format("💰%d %s%s 📏%d", bounty, disTag, szTag, dist)

        -- Highlight current target
        if p == currentTarget then
            obj.box.BorderColor3 = Color3.fromRGB(255, 200, 0)
        else
            obj.box.BorderColor3 = Color3.fromRGB(255, 50, 50)
        end

        -- Tracer
        local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
        obj.line.From    = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y - 10)
        obj.line.To      = Vector2.new(screenPos.X, screenPos.Y)
        obj.line.Visible = onScreen

    end
end

-- Clean up ESP on player leave
Players.PlayerRemoving:Connect(clearESP)

-- ══════════════════════════════════════
--  MAIN LOOP
-- ══════════════════════════════════════
RunService.Heartbeat:Connect(function()
    -- ESP update ทุก frame
    updateESP()

    if not CFG.enabled then
        currentTarget = nil
        return
    end

    local myHum = getHum(LocalPlayer)
    if not myHum or myHum.Health <= 0 then
        currentTarget = nil
        return
    end

    -- หาเป้าใหม่ทุกรอบ
    currentTarget = findTarget()
    if not currentTarget then return end

    local myRoot = getRoot(LocalPlayer)
    local tRoot  = getRoot(currentTarget)
    if not myRoot or not tRoot then return end

    local dist = (myRoot.Position - tRoot.Position).Magnitude

    -- เข้าหาเป้า
    if dist > CFG.safeStopDist then
        moveTo(currentTarget)
    end

    -- ตีจริง เมื่ออยู่ในระยะ
    if dist <= CFG.attackRange then
        doAttack(currentTarget)
    end
end)


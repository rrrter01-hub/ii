-- [[ Blox Fruits God-Tier Auto Bounty Hunter v68 ]] --
-- Features: Custom Dark UI, PvP-Only Target Filtering, Fast Attack M1, Multi-Weapon Rotation, Auto Haki

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local VirtualInputManager = game:GetService("VirtualInputManager")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")
local Humanoid = Character:WaitForChild("Humanoid")

-- State & Settings
local Settings = {
    AutoBounty = false,
    FastAttack = true,
    AutoHaki = true,
    TargetPvPOnly = true,
    SelectedTargetName = "Auto Nearest",
    TweenSpeed = 350,
    AttackDistance = 5, -- ติดตัวเพื่อให้หมัด/สกิลโดน 100%
    WeaponSequence = {"Melee", "Blox Fruit", "Sword", "Gun"},
    Skills = {"Z", "X", "C", "V"},
    SafeZoneCheck = true
}

local CurrentTarget = nil
local CurrentTween = nil

-- Character Setup
LocalPlayer.CharacterAdded:Connect(function(char)
    Character = char
    RootPart = char:WaitForChild("HumanoidRootPart")
    Humanoid = char:WaitForChild("Humanoid")
end)

-- Auto Buso Haki (เกราะ)
local function EnsureHaki()
    if not Settings.AutoHaki or not Character then return end
    if not Character:FindFirstChild("HasBuso") then
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local commF = remotes and remotes:FindFirstChild("CommF_")
        if commF then
            commF:InvokeServer("Buso")
        end
    end
end

-- Check PvP & Safezone Status
local function IsPvPActive(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return false end
    local targetChar = targetPlayer.Character
    
    -- Safezone / ForceField Check
    if targetChar:FindFirstChildOfClass("ForceField") then return false end
    
    -- Blox Fruits PvP Flag check
    local leaderstats = targetPlayer:FindFirstChild("leaderstats")
    local data = targetPlayer:FindFirstChild("Data")
    if data and data:FindFirstChild("PvP") and data.PvP.Value == false then
        return false
    end
    
    return true
end

-- Equip Weapon Category
local function EquipWeapon(category)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack or not Character then return end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local toolType = tool:GetAttribute("WeaponType") or tool.ToolTip
            if toolType == category or (category == "Melee" and tool:FindFirstChild("CombatScript")) or tool.Name:lower():find(category:lower()) then
                Humanoid:EquipTool(tool)
                return tool
            end
        end
    end
    return Character:FindFirstChildOfClass("Tool")
end

-- Fast Attack M1 Spam
local function TriggerFastAttack()
    if not Settings.FastAttack then return end
    
    -- Method 1: VirtualUser Click
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))
    
    -- Method 2: Combat Framework Register
    local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
    if net and net:FindFirstChild("RegisterAttack") then
        net.RegisterAttack:FireServer(0)
    end
end

-- Get Valid Target List
local function GetPlayerList()
    local list = {"Auto Nearest"}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p.Name)
        end
    end
    return list
end

-- Target Selection
local function GetTarget()
    if Settings.SelectedTargetName ~= "Auto Nearest" then
        local specific = Players:FindFirstChild(Settings.SelectedTargetName)
        if specific and specific.Character and specific.Character:FindFirstChild("Humanoid") and specific.Character.Humanoid.Health > 0 then
            if not Settings.TargetPvPOnly or IsPvPActive(specific) then
                return specific
            end
        end
    end

    local nearest = nil
    local minDist = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
            if p.Character.Humanoid.Health > 0 and (not Settings.TargetPvPOnly or IsPvPActive(p)) then
                local dist = (RootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = p
                end
            end
        end
    end
    return nearest
end

-- Tween to Target (Bypass desync)
local function TweenToTarget(cframe)
    if not RootPart then return end
    local dist = (RootPart.Position - cframe.Position).Magnitude
    local time = dist / Settings.TweenSpeed
    
    if CurrentTween then CurrentTween:Cancel() end
    
    local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)
    CurrentTween = TweenService:Create(RootPart, tweenInfo, {CFrame = cframe})
    
    -- Anti-Fall & Noclip
    for _, part in ipairs(Character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.Velocity = Vector3.new(0, 0, 0)
        end
    end
    
    CurrentTween:Play()
end

-- Combat Combo Engine
local function ExecuteFullCombo(targetChar)
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    local targetHum = targetChar:FindFirstChild("Humanoid")
    if not targetHRP or not targetHum or targetHum.Health <= 0 then return end

    EnsureHaki()

    -- Cycle All Configured Weapon Types (Melee -> Fruit -> Sword -> Gun)
    for _, weaponCat in ipairs(Settings.WeaponSequence) do
        if not Settings.AutoBounty or targetHum.Health <= 0 then break end
        
        EquipWeapon(weaponCat)
        task.wait(0.1)

        -- Aim lock to target
        RootPart.CFrame = CFrame.new(RootPart.Position, targetHRP.Position)

        -- M1 Attack Burst
        for i = 1, 4 do
            TriggerFastAttack()
            task.wait(0.08)
        end

        -- Cast Skills
        for _, skillKey in ipairs(Settings.Skills) do
            if targetHum.Health <= 0 or not Settings.AutoBounty then break end
            
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[skillKey], false, game)
            task.wait(0.12)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[skillKey], false, game)
            task.wait(0.3)
        end
    end
end

-- Main Combat Loop
task.spawn(function()
    while true do
        task.wait(0.05)
        if Settings.AutoBounty then
            CurrentTarget = GetTarget()
            if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
                local tHRP = CurrentTarget.Character.HumanoidRootPart
                local tHum = CurrentTarget.Character:FindFirstChild("Humanoid")
                
                if tHum and tHum.Health > 0 then
                    -- Position locked behind/above target for optimal hit registration
                    local attackCFrame = tHRP.CFrame * CFrame.new(0, 0, Settings.AttackDistance)
                    TweenToTarget(attackCFrame)
                    
                    if (RootPart.Position - attackCFrame.Position).Magnitude <= 10 then
                        ExecuteFullCombo(CurrentTarget.Character)
                    end
                end
            end
        end
    end
end)

-- [[ Modern Custom Dark UI ]] --
local function BuildUI()
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "OnyxBountyUI"
    ScreenGui.ResetOnSpawn = false
    
    local success, coreGui = pcall(function() return game:GetService("CoreGui") end)
    ScreenGui.Parent = success and coreGui or LocalPlayer:WaitForChild("PlayerGui")

    local MainFrame = Instance.new("Frame")
    MainFrame.Size = UDim2.new(0, 320, 0, 380)
    MainFrame.Position = UDim2.new(0.5, -160, 0.3, 0)
    MainFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    MainFrame.BorderSizePixel = 0
    MainFrame.Active = true
    MainFrame.Draggable = true
    MainFrame.Parent = ScreenGui

    local UICorner = Instance.new("UICorner", MainFrame)
    UICorner.CornerRadius = UDim.new(0, 10)

    local UIStroke = Instance.new("UIStroke", MainFrame)
    UIStroke.Color = Color3.fromRGB(70, 70, 90)
    UIStroke.Thickness = 1.5

    -- Title
    local Title = Instance.new("TextLabel", MainFrame)
    Title.Size = UDim2.new(1, 0, 0, 40)
    Title.Text = "ONYX BOUNTY HUNTER v68"
    Title.TextColor3 = Color3.fromRGB(240, 240, 255)
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 14
    Title.BackgroundTransparency = 1

    local Layout = Instance.new("UIListLayout", MainFrame)
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Padding = UDim.new(0, 8)
    Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local function CreateButton(text, defaultState, callback)
        local btn = Instance.new("TextButton", MainFrame)
        btn.Size = UDim2.new(0.9, 0, 0, 38)
        btn.BackgroundColor3 = defaultState and Color3.fromRGB(45, 120, 75) or Color3.fromRGB(35, 35, 45)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 13
        btn.Text = text .. ": " .. (defaultState and "ON" or "OFF")
        
        local btnCorner = Instance.new("UICorner", btn)
        btnCorner.CornerRadius = UDim.new(0, 6)
        
        local state = defaultState
        btn.MouseButton1Click:Connect(function()
            state = not state
            btn.BackgroundColor3 = state and Color3.fromRGB(45, 120, 75) or Color3.fromRGB(35, 35, 45)
            btn.Text = text .. ": " .. (state and "ON" or "OFF")
            callback(state)
        end)
    end

    -- Controls
    CreateButton("Auto Bounty Hunt", Settings.AutoBounty, function(val)
        Settings.AutoBounty = val
        if not val and CurrentTween then CurrentTween:Cancel() end
    end)

    CreateButton("Target PvP Players Only", Settings.TargetPvPOnly, function(val)
        Settings.TargetPvPOnly = val
    end)

    CreateButton("Fast Attack (M1 Spam)", Settings.FastAttack, function(val)
        Settings.FastAttack = val
    end)

    CreateButton("Auto Buso Haki", Settings.AutoHaki, function(val)
        Settings.AutoHaki = val
    end)

    -- Target Selector Display
    local TargetLabel = Instance.new("TextLabel", MainFrame)
    TargetLabel.Size = UDim2.new(0.9, 0, 0, 32)
    TargetLabel.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
    TargetLabel.TextColor3 = Color3.fromRGB(200, 200, 220)
    TargetLabel.Font = Enum.Font.Gotham
    TargetLabel.TextSize = 12
    TargetLabel.Text = "Target: Auto Nearest (PvP Active)"
    local tCorner = Instance.new("UICorner", TargetLabel)
    tCorner.CornerRadius = UDim.new(0, 6)

    -- Status Updater
    task.spawn(function()
        while ScreenGui.Parent do
            task.wait(0.5)
            if CurrentTarget and CurrentTarget.Character then
                TargetLabel.Text = "Hunting: " .. CurrentTarget.Name .. " (" .. tostring(math.floor(CurrentTarget.Character.Humanoid.Health)) .. " HP)"
            else
                TargetLabel.Text = "Status: Searching for PvP targets..."
            end
        end
    end)
end

BuildUI()

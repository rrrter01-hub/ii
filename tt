function SetupCombatHooks()
    pcall(function()
        local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
        if playerScripts and playerScripts:FindFirstChild("CombatFramework") then
            CombatFramework = require(playerScripts.CombatFramework)
            ActiveController = CombatFramework.activeController
        end
    end)
end
SetupCombatHooks()

-- [[ Auto Enable PvP & Haki ]] --
local function EnsurePvPAndHaki()
    if not Character then return end
    pcall(function()
        if Config.AutoPvP and CommF then
            if Character:FindFirstChild("PvPDisabled") then
                CommF:InvokeServer("EnablePvp")
            end
        end
        if Config.AutoHaki and CommF then
            if not Character:FindFirstChild("HasBuso") then
                CommF:InvokeServer("Buso")
            end
        end
    end)
end

-- [[ Comprehensive SafeZone Cache ]] --
local SafeZones = {}
for _, obj in ipairs(Workspace:GetDescendants()) do
    if obj:IsA("BasePart") and (obj.Name:lower():find("safezone") or obj.Name:lower():find("peace") or obj.Name == "SafeZone") then
        table.insert(SafeZones, obj)
    end
end

local function IsInSafeZone(pos)
    for _, zone in ipairs(SafeZones) do
        if zone and zone.Parent then
            local rel = zone.CFrame:PointToObjectSpace(pos)
            local sz = zone.Size / 2
            if math.abs(rel.X) <= sz.X + 5 and math.abs(rel.Y) <= sz.Y + 5 and math.abs(rel.Z) <= sz.Z + 5 then
                return true
            end
        end
    end
    return false
end

-- [[ Check if Player has Active PvP & is Vulnerable ]] --
local function IsValidTarget(player)
    if not player or player == LocalPlayer then return false end
    
    -- Check Blacklist Expiration
    if BlacklistedTargets[player] then
        if tick() < BlacklistedTargets[player] then
            return false
        else
            BlacklistedTargets[player] = nil
        end
    end

    local char = player.Character
    if not char then return false end

    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return false end

    -- Check ForceField (Spawn Protection)
    if char:FindFirstChildOfClass("ForceField") then return false end

    -- Check PvP Disabled Flags (Character & Player Object)
    if char:FindFirstChild("PvPDisabled") or player:FindFirstChild("PvPDisabled") then return false end

    -- Check SafeZone Positioning
    if IsInSafeZone(hrp.Position) then return false end

    return true
end

-- [[ Smart Target Selector ]] --
local function GetBestTarget()
    local best = nil
    local shortest = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if IsValidTarget(p) then
            local hrp = p.Character.HumanoidRootPart
            local dist = (RootPart.Position - hrp.Position).Magnitude
            if dist < shortest then
                shortest = dist
                best = p
            end
        end
    end
    return best
end

-- [[ Weapon Rotator ]] --
local function SwitchToNextWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack or not Character or not Humanoid then return end

    local category = Config.Weapons[CurrentWeaponIndex]
    local targetTool = nil

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local tType = tool:GetAttribute("WeaponType") or tool.ToolTip
            if tType == category or tool.Name:lower():find(category:lower()) or (category == "Melee" and (tool:FindFirstChild("CombatScript") or tool.ToolTip == "Melee")) then
                targetTool = tool
                break
            end
        end
    end

    if targetTool then
        Humanoid:EquipTool(targetTool)
    end

    CurrentWeaponIndex = (CurrentWeaponIndex % #Config.Weapons) + 1
end

-- [[ Attack Register Engine ]] --
local function ExecuteFastAttack(targetHRP)
    if not Config.FastAttack or not targetHRP then return end

    pcall(function()
        if not ActiveController then SetupCombatHooks() end
        if ActiveController then
            ActiveController.timeToNextAttack = 0
            ActiveController.attacking = false
            ActiveController.blocking = false
            ActiveController.hitboxMagnitude = 85
            ActiveController.increment = 3
            if ActiveController.attack then ActiveController:attack() end
            if ActiveController.bladeHit then ActiveController.bladeHit(targetHRP, {targetHRP}) end
        end
    end)

    pcall(function()
        if RegisterAttack then RegisterAttack:FireServer(0) end
        if RegisterHit then RegisterHit:FireServer(targetHRP, {{targetHRP.Parent, targetHRP}}) end
    end)

    local currentTool = Character:FindFirstChildOfClass("Tool")
    if currentTool then currentTool:Activate() end
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))
end

-- [[ Camera Aim & Skill Cast ]] --
local function FireSkills(targetHRP, targetHum)
    if not Config.SkillSpam or not targetHRP or targetHum.Health <= 0 then return end
    pcall(function()
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHRP.Position)
    end)

    for _, key in ipairs(Config.Skills) do
        if not CurrentTarget or targetHum.Health <= 0 then break end
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
        task.wait(0.04)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
        task.wait(0.06)
    end
end

-- [[ Overhead Hover Movement ]] --
local function HoverOverhead(targetHRP)
    EnsurePhysicsAnchor()
    local overheadCFrame = CFrame.new(targetHRP.Position + Vector3.new(0, Config.OverheadDistance, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
    local currentPos = RootPart.Position
    local targetPos = overheadCFrame.Position
    local dist = (currentPos - targetPos).Magnitude

    if dist > 120 then
        RootPart.CFrame = CFrame.new(currentPos:Lerp(targetPos, (Config.FlySpeed * 0.03) / dist))
    else
        RootPart.CFrame = overheadCFrame
    end
end

-- [[ Master Combat Loop with Anti-Stuck Damage Engine ]] --
task.spawn(function()
    while true do
        task.wait(0.015)
        
        if Config.Enabled then
            EnsurePvPAndHaki()

            -- ตรวจสอบว่าเป้าหมายปัจจุบันยัง Valid หรือไม่
            if not CurrentTarget or not IsValidTarget(CurrentTarget) then
                CurrentTarget = GetBestTarget()
                if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                    TargetTrack.Player = CurrentTarget
                    TargetTrack.StartTick = tick()
                    TargetTrack.InitialHP = CurrentTarget.Character.Humanoid.Health
                else
                    TargetTrack.Player = nil
                end
            end

            if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
                local tHRP = CurrentTarget.Character.HumanoidRootPart
                local tHum = CurrentTarget.Character.Humanoid

                -- ระบบตรวจจับดาเมจ (Anti-Stuck Damage Check)
                if TargetTrack.Player == CurrentTarget then
                    local elapsed = tick() - TargetTrack.StartTick
                    if elapsed >= Config.StuckTimeout then
                        -- ถ้าเวลาผ่านไปแล้วเลือดยังไม่ลดเลย = เป้าหมายอยู่ในเซฟโซนที่เช็คไม่เจอ หรือ ปิด PvP อยู่
                        if tHum.Health >= TargetTrack.InitialHP then
                            BlacklistedTargets[CurrentTarget] = tick() + Config.BlacklistDuration
                            CurrentTarget = nil
                            TargetTrack.Player = nil
                        else
                            -- ทำดาเมจเข้า รีเซ็ตตัวนับ
                            TargetTrack.StartTick = tick()
                            TargetTrack.InitialHP = tHum.Health
                        end
                    end
                else
                    TargetTrack.Player = CurrentTarget
                    TargetTrack.StartTick = tick()
                    TargetTrack.InitialHP = tHum.Health
                end

                if CurrentTarget then
                    HoverOverhead(tHRP)

                    if tick() - LastWeaponSwitch >= Config.WeaponSwitchDelay then
                        SwitchToNextWeapon()
                        LastWeaponSwitch = tick()
                    end

                    local dist = (RootPart.Position - tHRP.Position).Magnitude
                    if dist <= (Config.OverheadDistance + 15) then
                        ExecuteFastAttack(tHRP)
                        FireSkills(tHRP, tHum)
                    end
                end
            end
        else
            RemovePhysicsAnchor()
        end
    end
end)


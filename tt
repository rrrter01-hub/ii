-- [[ Blox Fruits Stable Overhead Bounty Hunter v68 (Fixed Combat & Aimlock) ]] --
-- Architecture: Overhead Hover (Y+11), BodyVelocity Anchor, Perfected Aimlock & Parallel Combat

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local VirtualUser = game:GetService("VirtualUser")
local VirtualInputManager = game:GetService("VirtualInputManager")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")
local Humanoid = Character:WaitForChild("Humanoid")

-- [[ Master Configuration ]] --
local Config = {
    Enabled = false,
    OverheadDistance = 11,   -- ความสูงเหนือหัวเป้าหมาย (studs)
    FlySpeed = 300,
    FastAttack = true,
    AutoHaki = true,
    SkillSpam = true,
    Skills = {"Z", "X", "C", "V"},
    Weapons = {"Melee", "Sword", "Blox Fruit"}
}

local CurrentTarget = nil
local BodyVel = nil
local CombatFramework = nil
local ActiveController = nil

-- [[ Anti-Fall / Anti-Physics Desync (BodyVelocity Anchor) ]] --
local function EnsurePhysicsAnchor()
    if not RootPart then return end
    if not BodyVel or BodyVel.Parent ~= RootPart then
        if BodyVel then BodyVel:Destroy() end
        BodyVel = Instance.new("BodyVelocity")
        BodyVel.Name = "OnyxAnchor"
        BodyVel.Velocity = Vector3.new(0, 0, 0)
        BodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        BodyVel.P = 1250
        BodyVel.Parent = RootPart
    end
end

local function RemovePhysicsAnchor()
    if BodyVel then
        BodyVel:Destroy()
        BodyVel = nil
    end
end

-- [[ Infinite Noclip Loop (Stepped) ]] --
RunService.Stepped:Connect(function()
    if Config.Enabled and Character then
        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        if RootPart then
            RootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            RootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end
end)

-- Character Refresh
LocalPlayer.CharacterAdded:Connect(function(char)
    Character = char
    RootPart = char:WaitForChild("HumanoidRootPart")
    Humanoid = char:WaitForChild("Humanoid")
    task.wait(0.5)
    EnsurePhysicsAnchor()
end)

-- [[ Hook Blox Fruits Combat Controller (Real Damage Hits) ]] --
local function SetupCombatHooks()
    pcall(function()
        local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
        if playerScripts and playerScripts:FindFirstChild("CombatFramework") then
            CombatFramework = require(playerScripts.CombatFramework)
            ActiveController = CombatFramework.activeController
        end
    end)
end
SetupCombatHooks()

-- [[ Auto Buso Haki ]] --
local function CheckHaki()
    if not Config.AutoHaki or not Character then return end
    if not Character:FindFirstChild("HasBuso") then
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local commF = remotes and remotes:FindFirstChild("CommF_")
        if commF then
            commF:InvokeServer("Buso")
        end
    end
end

-- [[ SafeZone Cache ]] --
local SafeZones = {}
for _, obj in ipairs(Workspace:GetDescendants()) do
    if (obj.Name == "SafeZone" or obj.Name:lower():find("safezone")) and obj:IsA("BasePart") then
        table.insert(SafeZones, obj)
    end
end

local function IsInSafeZone(pos)
    for _, zone in ipairs(SafeZones) do
        if zone and zone.Parent then
            local rel = zone.CFrame:PointToObjectSpace(pos)
            local sz = zone.Size / 2
            if math.abs(rel.X) <= sz.X and math.abs(rel.Y) <= sz.Y and math.abs(rel.Z) <= sz.Z then
                return true
            end
        end
    end
    return false
end

-- [[ Strict Single Target Selection ]] --
local function GetBestTarget()
    local best = nil
    local shortest = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
            local char = p.Character
            local hum = char.Humanoid
            local hrp = char.HumanoidRootPart

            if hum.Health > 0 and not char:FindFirstChildOfClass("ForceField") and not char:FindFirstChild("PvPDisabled") then
                if not IsInSafeZone(hrp.Position) then
                    local dist = (RootPart.Position - hrp.Position).Magnitude
                    if dist < shortest then
                        shortest = dist
                        best = p
                    end
                end
            end
        end
    end
    return best
end

-- [[ Auto Equip Best Weapon ]] --
local function EquipPreferredWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack or not Character then return end

    if not Character:FindFirstChildOfClass("Tool") then
        for _, category in ipairs(Config.Weapons) do
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then
                    local tType = tool:GetAttribute("WeaponType") or tool.ToolTip
                    if tType == category or tool.Name:lower():find(category:lower()) or (category == "Melee" and tool:FindFirstChild("CombatScript")) then
                        Humanoid:EquipTool(tool)
                        return
                    end
                end
            end
        end
    end
end

-- [[ AimLock Directly onto Target (Camera + Character) ]] --
local function AimAtTarget(targetPosition)
    Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPosition)
end

-- [[ Real Fast Attack Registration (Extended Hitbox) ]] --
local function ExecuteFastAttack()
    if not Config.FastAttack then return end

    -- 1. In-game Controller Attack Trigger with Boosted Hitbox
    if ActiveController and ActiveController.attack then
        pcall(function()
            ActiveController.timeToNextAttack = 0
            ActiveController.hitboxMagnitude = 75
            ActiveController:attack()
        end)
    end

    -- 2. Tool Activate & Hardware Emulation Fallback
    local currentTool = Character:FindFirstChildOfClass("Tool")
    if currentTool then
        currentTool:Activate()
    end
    
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))

    -- 3. Remote Event Trigger
    local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
    if net and net:FindFirstChild("RegisterAttack") then
        net.RegisterAttack:FireServer(0)
    end
end

-- [[ Smooth Overhead Flight Movement ]] --
local function HoverOverhead(targetHRP)
    EnsurePhysicsAnchor()
    
    -- Target overhead position: 11 studs directly above the target, aiming downward directly at target
    local overheadCFrame = CFrame.new(targetHRP.Position + Vector3.new(0, Config.OverheadDistance, 0), targetHRP.Position)
    local currentPos = RootPart.Position
    local targetPos = overheadCFrame.Position
    local dist = (currentPos - targetPos).Magnitude

    if dist > 150 then
        RootPart.CFrame = CFrame.new(currentPos:Lerp(targetPos, (Config.FlySpeed * 0.03) / dist), targetHRP.Position)
    else
        RootPart.CFrame = overheadCFrame
    end
end

-- [[ THREAD 1: Continuous M1 Fast Attack (รัวหมัดไม่สะดุด) ]] --
task.spawn(function()
    while true do
        task.wait(0.02)
        if Config.Enabled and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
            local tHRP = CurrentTarget.Character.HumanoidRootPart
            local dist = (RootPart.Position - tHRP.Position).Magnitude
            if dist <= (Config.OverheadDistance + 14) then
                EquipPreferredWeapon()
                AimAtTarget(tHRP.Position)
                ExecuteFastAttack()
            end
        end
    end
end)

-- [[ THREAD 2: Parallel Skills with AimLock (ยิงสกิลอัดกลางตัวเป้าหมาย) ]] --
task.spawn(function()
    while true do
        task.wait(0.08)
        if Config.Enabled and Config.SkillSpam and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
            local tHRP = CurrentTarget.Character.HumanoidRootPart
            local tHum = CurrentTarget.Character:FindFirstChild("Humanoid")
            local dist = (RootPart.Position - tHRP.Position).Magnitude

            if dist <= (Config.OverheadDistance + 14) and tHum and tHum.Health > 0 then
                for _, key in ipairs(Config.Skills) do
                    if not Config.Enabled or not CurrentTarget or tHum.Health <= 0 then break end
                    AimAtTarget(tHRP.Position)
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
                    task.wait(0.04)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
                    task.wait(0.12)
                end
            end
        end
    end
end)

-- [[ Master Navigation & Tracking Loop ]] --
task.spawn(function()
    while true do
        task.wait(0.02)
        
        if Config.Enabled then
            -- Check Target Validity
            if not CurrentTarget or not CurrentTarget.Character or not CurrentTarget.Character:FindFirstChild("Humanoid") or CurrentTarget.Character.Humanoid.Health <= 0 or IsInSafeZone(CurrentTarget.Character.HumanoidRootPart.Position) then
                CurrentTarget = GetBestTarget()
            end

            if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
                local tHRP = CurrentTarget.Character.HumanoidRootPart
                
                -- Lock overhead & Haki
                HoverOverhead(tHRP)
                CheckHaki()
            end
        else
            RemovePhysicsAnchor()
        end
    end
end)


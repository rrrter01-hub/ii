-- [[ Blox Fruits Zero-Delay Overhead Bounty Engine v68 ]] --
-- Features: Parallel M1 + Skill Threads (No Delay), Aimlock Raycast, Auto Enable PvP, Overhead BodyVel Anchor

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local VirtualUser = game:GetService("VirtualUser")
local VirtualInputManager = game:GetService("VirtualInputManager")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")
local Humanoid = Character:WaitForChild("Humanoid")

-- [[ Master Configuration ]] --
local Config = {
    Enabled = false,
    OverheadDistance = 10.5, -- ระยะลอยเหนือหัวเป้าหมาย (studs)
    FlySpeed = 330,
    FastAttack = true,
    AutoPvP = true,          -- บังคับเปิด PvP ตัวเองตลอดเวลา
    AutoHaki = true,         -- ฮาคิเกราะ + สังเกต
    SkillRotation = {"Z", "X", "C", "V"},
    Weapons = {"Melee", "Blox Fruit", "Sword", "Gun"}
}

local CurrentTarget = nil
local BodyVel = nil
local CombatFramework = nil
local ActiveController = nil

-- [[ Physics Anchor (กันตก / กันเด้ง / ลอยนิ่ง 100%) ]] --
local function MaintainAnchor()
    if not RootPart then return end
    if not BodyVel or BodyVel.Parent ~= RootPart then
        if BodyVel then BodyVel:Destroy() end
        BodyVel = Instance.new("BodyVelocity")
        BodyVel.Name = "OnyxAnchor"
        BodyVel.Velocity = Vector3.new(0, 0, 0)
        BodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        BodyVel.P = 1500
        BodyVel.Parent = RootPart
    end
end

local function ClearAnchor()
    if BodyVel then
        BodyVel:Destroy()
        BodyVel = nil
    end
end

-- [[ Anti-Collide & Zero Gravity (Stepped) ]] --
RunService.Stepped:Connect(function()
    if Config.Enabled and Character then
        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        if RootPart then
            RootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            RootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end
end)

-- Character Respawn Handling
LocalPlayer.CharacterAdded:Connect(function(char)
    Character = char
    RootPart = char:WaitForChild("HumanoidRootPart")
    Humanoid = char:WaitForChild("Humanoid")
    task.wait(0.5)
    MaintainAnchor()
end)

-- [[ Hook Combat Framework ]] --
local function InitCombatFramework()
    pcall(function()
        local pScripts = LocalPlayer:FindFirstChild("PlayerScripts")
        if pScripts and pScripts:FindFirstChild("CombatFramework") then
            CombatFramework = require(pScripts.CombatFramework)
            ActiveController = CombatFramework.activeController
        end
    end)
end
InitCombatFramework()

-- [[ Force Enable PvP & Auto Haki ]] --
local function ForceEnablePvPAndHaki()
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local commF = remotes and remotes:FindFirstChild("CommF_")
        if commF then
            -- 1. บังคับเปิด PvP
            if Config.AutoPvP then
                commF:InvokeServer("EnablePvP")
                commF:InvokeServer("PvP", true)
            end
            
            -- 2. เปิดฮาคิเกราะ (Buso)
            if Config.AutoHaki and Character and not Character:FindFirstChild("HasBuso") then
                commF:InvokeServer("Buso")
            end
        end
    end)
end

-- [[ SafeZone Cache ]] --
local SafeZones = {}
for _, obj in ipairs(Workspace:GetDescendants()) do
    if (obj.Name == "SafeZone" or obj.Name:lower():find("safezone")) and obj:IsA("BasePart") then
        table.insert(SafeZones, obj)
    end
end

local function IsInSafeZone(pos)
    for _, zone in ipairs(SafeZones) do
        if zone and zone.Parent then
            local rel = zone.CFrame:PointToObjectSpace(pos)
            local sz = zone.Size / 2
            if math.abs(rel.X) <= sz.X and math.abs(rel.Y) <= sz.Y and math.abs(rel.Z) <= sz.Z then
                return true
            end
        end
    end
    return false
end

-- [[ Single Target Acquirer ]] --
local function AcquireTarget()
    local nearest = nil
    local minDist = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
            local char = player.Character
            local hum = char.Humanoid
            local hrp = char.HumanoidRootPart

            if hum.Health > 0 and not char:FindFirstChildOfClass("ForceField") and not char:FindFirstChild("PvPDisabled") then
                if not IsInSafeZone(hrp.Position) then
                    local dist = (RootPart.Position - hrp.Position).Magnitude
                    if dist < minDist then
                        minDist = dist
                        nearest = player
                    end
                end
            end
        end
    end
    return nearest
end

-- [[ Auto Equip Next Available Weapon ]] --
local function EquipPreferredWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack or not Character then return end

    if not Character:FindFirstChildOfClass("Tool") then
        for _, category in ipairs(Config.Weapons) do
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then
                    local tType = tool:GetAttribute("WeaponType") or tool.ToolTip
                    if tType == category or tool.Name:lower():find(category:lower()) or (category == "Melee" and tool:FindFirstChild("CombatScript")) then
                        Humanoid:EquipTool(tool)
                        return
                    end
                end
            end
        end
    end
end

-- [[ Fast Attack M1 Execution (Zero Delay) ]] --
local function ExecuteM1Attack()
    if not Config.FastAttack then return end

    -- Combat Framework Hook
    if ActiveController and ActiveController.attack then
        pcall(function()
            ActiveController.timeToNextAttack = 0
            ActiveController.hitboxMagnitude = 65
            ActiveController:attack()
        end)
    end

    -- Tool Activation
    local tool = Character:FindFirstChildOfClass("Tool")
    if tool then tool:Activate() end

    -- Hardware Click Fallback
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))

    -- Net Remote Attack
    local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
    if net and net:FindFirstChild("RegisterAttack") then
        net.RegisterAttack:FireServer(0)
    end
end

-- [[ AimLock Camera & Mouse Directly onto Target ]] --
local function AimLockTarget(targetHRP)
    if not targetHRP then return end
    Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHRP.Position)
    RootPart.CFrame = CFrame.new(RootPart.Position, Vector3.new(targetHRP.Position.X, RootPart.Position.Y, targetHRP.Position.Z))
end

-- [[ THREAD 1: Continuous M1 Fast Attack (รัวหมัดไม่หยุด) ]] --
task.spawn(function()
    while true do
        task.wait(0.02)
        if Config.Enabled and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
            local tHRP = CurrentTarget.Character.HumanoidRootPart
            local dist = (RootPart.Position - tHRP.Position).Magnitude
            
            if dist <= (Config.OverheadDistance + 14) then
                EquipPreferredWeapon()
                ExecuteM1Attack()
            end
        end
    end
end)

-- [[ THREAD 2: Parallel Skill Execution (กดสกิลทันที + ล็อคเป้า ไม่ขัดหมัด) ]] --
task.spawn(function()
    while true do
        task.wait(0.1)
        if Config.Enabled and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
            local tHRP = CurrentTarget.Character.HumanoidRootPart
            local tHum = CurrentTarget.Character:FindFirstChild("Humanoid")
            local dist = (RootPart.Position - tHRP.Position).Magnitude

            if dist <= (Config.OverheadDistance + 14) and tHum and tHum.Health > 0 then
                for _, key in ipairs(Config.SkillRotation) do
                    if not Config.Enabled or not CurrentTarget or tHum.Health <= 0 then break end
                    
                    AimLockTarget(tHRP)
                    
                    -- Trigger Skill Key
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
                    task.wait(0.04)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
                    task.wait(0.12)
                end
            end
        end
    end
end)

-- [[ THREAD 3: Master Overhead Flight & Target Navigation ]] --
task.spawn(function()
    while true do
        task.wait(0.02)

        if Config.Enabled then
            ForceEnablePvPAndHaki()

            -- Target Validation Check
            if not CurrentTarget or not CurrentTarget.Character or not CurrentTarget.Character:FindFirstChild("Humanoid") or CurrentTarget.Character.Humanoid.Health <= 0 or IsInSafeZone(CurrentTarget.Character.HumanoidRootPart.Position) then
                CurrentTarget = AcquireTarget()
            end

            if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
                local tHRP = CurrentTarget.Character.HumanoidRootPart
                MaintainAnchor()

                -- Lock exactly 10.5 studs overhead, facing downwards
                local overheadTarget = CFrame.new(tHRP.Position + Vector3.new(0, Config.OverheadDistance, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
                local curPos = RootPart.Position
                local targetPos = overheadTarget.Position
                local dist = (curPos - targetPos).Magnitude

                if dist > 120 then
                    -- Smooth lerp travel across long distances
                    RootPart.CFrame = CFrame.new(curPos:Lerp(targetPos, (Config.FlySpeed * 0.02) / dist))
                else
                    -- Direct sticky lock overhead
                    RootPart.CFrame = overheadTarget
                end
            end
        else
            ClearAnchor()
        end
    end
end)


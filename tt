    Status.TextWrapped = true
    Status.Text = "Status: Standing By"
    local sCorner = Instance.new("UICorner", Status)
    sCorner.CornerRadius = UDim.new(0, 6)

    task.spawn(function()
        while ScreenGui.Parent do
            task.wait(0.2)
            if not Config.Enabled then
                Status.Text = "Mode: IDLE\nAnti-Rubberband Engine: ACTIVE\nVector Fly: 320 Speed\n12-Queue Round-Robin: READY"
            elseif CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                local hp = math.floor(CurrentTarget.Character.Humanoid.Health)
                local maxHp = math.floor(CurrentTarget.Character.Humanoid.MaxHealth)
                local probeTxt = IsProbingDamage and "TESTING DAMAGE (0.8s)" or "ATTACKING"
                Status.Text = string.format("LOCKED: %s\nHP: %d / %d\nState: %s\nWeapon: %s\nTested In Server: %d Players",
                    CurrentTarget.Name, hp, maxHp, probeTxt, Config.Weapons[CurrentWeaponIndex] or "Melee", (function() local c=0; for _ in pairs(TriedPlayers) do c=c+1 end return c end)())
            else
                Status.Text = "Mode: SCANNING QUEUE\nAcquiring next valid player..."

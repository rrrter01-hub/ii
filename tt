    Status.Size = UDim2.new(0.9, 0, 0, 140)
    Status.Position = UDim2.new(0.05, 0, 0, 98)
    Status.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    Status.TextColor3 = Color3.fromRGB(200, 220, 255)
    Status.Font = Enum.Font.Gotham
    Status.TextSize = 12
    Status.TextWrapped = true
    Status.Text = "Status: Idle"
    local sCorner = Instance.new("UICorner", Status)
    sCorner.CornerRadius = UDim.new(0, 6)

    task.spawn(function()
        while ScreenGui.Parent do
            task.wait(0.2)
            if not Config.Enabled then
                Status.Text = "Mode: IDLE\nRound-Robin 12-Queue: READY\n0.8s Damage Probe: ACTIVE\nDirect Missile Fly: READY"
            elseif CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                local hp = math.floor(CurrentTarget.Character.Humanoid.Health)
                local maxHp = math.floor(CurrentTarget.Character.Humanoid.MaxHealth)
                local testStatus = IsProbingDamage and "PROBING (0.8s)..." or "ATTACKING"
                Status.Text = string.format("LOCKED: %s\nHP: %d / %d\nState: %s\nWeapon: %s\nQueue Progress: %d Tested",
                    CurrentTarget.Name, hp, maxHp, testStatus, Config.Weapons[CurrentWeaponIndex] or "Melee", (function() local c=0; for _ in pairs(TriedPlayers) do c=c+1 end return c end)())
            else
                Status.Text = "Mode: QUEUE SCAN\nGrabbing next player from server queue..."
            end
        end
    end)
end


-- [[ Helper: Telemetry ]] --
local function GetPlayerLevel(player)
    if not player then return 0 end
    local data = player:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") then return tonumber(data.Level.Value) or 0 end
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats and leaderstats:FindFirstChild("Level") then return tonumber(leaderstats.Level.Value) or 0 end
    local attr = player:GetAttribute("Level")
    if attr then return tonumber(attr) or 0 end
    return 0
end

local function GetPlayerHealth(player)
    if player and player.Character and player.Character:FindFirstChild("Humanoid") then
        local hum = player.Character.Humanoid
        return math.floor(hum.Health), math.floor(hum.MaxHealth)
    end
    return 0, 0
end

local function GetDistanceToPlayer(player)
    if RootPart and player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        return math.floor((RootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude)
    end
    return 999999
end

local function IsPvPActive(player)
    if not player or not player.Character then return false end
    local char = player.Character
    if char:FindFirstChild("PvPDisabled") or player:FindFirstChild("PvPDisabled") then return false end
    if char:FindFirstChildOfClass("ForceField") then return false end
    if char:GetAttribute("PvPDisabled") == true or player:GetAttribute("PvPDisabled") == true then return false end
    return true
end

-- [[ Anti-Rollback Flight Physics (P=1250, MaxForce=4e4) ]] --
local function SetupFlightPhysics()
    if not RootPart then return end

    if not FlightBodyVelocity or FlightBodyVelocity.Parent ~= RootPart then
        if FlightBodyVelocity then FlightBodyVelocity:Destroy() end
        FlightBodyVelocity = Instance.new("BodyVelocity")
        FlightBodyVelocity.Name = "OnyxVelocityGlide"
        FlightBodyVelocity.Velocity = Vector3.new(0, 0, 0)
        FlightBodyVelocity.MaxForce = Vector3.new(4e4, 4e4, 4e4)
        FlightBodyVelocity.P = 1250
        FlightBodyVelocity.Parent = RootPart
    end

    if not FlightBodyGyro or FlightBodyGyro.Parent ~= RootPart then
        if FlightBodyGyro then FlightBodyGyro:Destroy() end
        FlightBodyGyro = Instance.new("BodyGyro")
        FlightBodyGyro.Name = "OnyxGyro"
        FlightBodyGyro.MaxTorque = Vector3.new(4e4, 4e4, 4e4)
        FlightBodyGyro.P = 1250
        FlightBodyGyro.D = 100
        FlightBodyGyro.CFrame = RootPart.CFrame
        FlightBodyGyro.Parent = RootPart
    end
end

local function ClearFlightPhysics()
    if FlightBodyVelocity then FlightBodyVelocity:Destroy(); FlightBodyVelocity = nil end
    if FlightBodyGyro then FlightBodyGyro:Destroy(); FlightBodyGyro = nil end
    if Humanoid then Humanoid.PlatformStand = false end
end


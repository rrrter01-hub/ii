                local lvl = GetPlayerLevel(nearestP)
                local hp, maxHp = GetPlayerHealth(nearestP)
                NearestRadar.Text = string.format("🎯 NEAREST(PvP✅): %s Lv.%d\nHP: %d/%d | %d studs", nearestP.Name, lvl, hp, maxHp, math.floor(minD))
            else
                NearestRadar.Text = "🎯 NEAREST: No PvP-enabled players nearby"
            end

            -- Status Box
            if not Config.Enabled then
                Status.Text = "Mode: IDLE\nSpeed: 160 studs/s (Anti-Rollback)\nAuto Hunt: " .. (Config.AutoHunt and "ON (ล่าหัวอัตโนมัติ)" or "OFF")
            elseif CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                local lvl = GetPlayerLevel(CurrentTarget)
                local hp, maxHp = GetPlayerHealth(CurrentTarget)
                local dist = GetDistanceToPlayer(CurrentTarget)
                local state = CombatTracker.HasDealtDamage and "🔴 EXECUTION (RELENTLESS)" or "🟡 APPROACHING / PROBING"
                Status.Text = string.format("LOCKED: %s (Lv.%d)\nDist: %d studs | HP: %d/%d\nState: %s\nMode: %s | Weapon: %s",
                    CurrentTarget.Name, lvl, dist, hp, maxHp, state, Config.TargetMode, Config.Weapons[CurrentWeaponIndex] or "Melee")
            else
                Status.Text = "🔍 AUTO HUNTING...\nSearching bounty eligible targets\n(PvP✅, Lv." .. Config.MinBountyLevel .. "+, No SafeZone)"
            end
        end
    end)
end

BuildUI()

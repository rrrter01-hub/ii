    Toggle.TextSize = 13
    Toggle.Text = "AUTO BOUNTY: OFF"
    local tCorner = Instance.new("UICorner", Toggle)
    tCorner.CornerRadius = UDim.new(0, 6)

    Toggle.MouseButton1Click:Connect(function()
        Config.Enabled = not Config.Enabled
        Toggle.BackgroundColor3 = Config.Enabled and Color3.fromRGB(45, 160, 95) or Color3.fromRGB(35, 35, 48)
        Toggle.Text = "AUTO BOUNTY: " .. (Config.Enabled and "HUNTING QUEUE" or "OFF")

-- [[ Blox Fruits Overhead Bounty Hunter v71 ]] --
-- Fix: Hard Target Lock (Zero Hesitation/No Switching), Direct Flight Velocity, In-Range Anti-Stuck Timer

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local VirtualInputManager = game:GetService("VirtualInputManager")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")
local Humanoid = Character:WaitForChild("Humanoid")

-- [[ Master Configuration ]] --
local Config = {
    Enabled = false,
    OverheadDistance = 11,
    FlySpeed = 380,
    FastAttack = true,
    AutoHaki = true,
    AutoPvP = true,
    SkillSpam = true,
    Skills = {"Z", "X", "C", "V"},
    Weapons = {"Melee", "Sword", "Blox Fruit", "Gun"},
    WeaponSwitchDelay = 0.8,
    CombatDamageTimeout = 2.0, -- วินาทีที่อยู่ในระยะโจมตีแล้วเลือดไม่ลด จะเปลี่ยนตัวทันที
    BlacklistDuration = 60     -- พักการล็อคตัวที่ตีไม่เข้า 60 วินาที
}

local CurrentTarget = nil
local BodyVel = nil
local CombatFramework = nil
local ActiveController = nil
local LastWeaponSwitch = 0
local CurrentWeaponIndex = 1

-- Target Sticky Lock & Damage Tracking
local BlacklistedTargets = {}
local CombatTracker = {
    Target = nil,
    EngagedTick = 0,
    LastKnownHP = 0
}

-- [[ Remotes ]] --
local Remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
local CommF = Remotes and Remotes:WaitForChild("CommF_", 5)
local NetModule = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
local RegisterAttack = NetModule and (NetModule:FindFirstChild("RegisterAttack") or NetModule:FindFirstChild("RE/RegisterAttack"))
local RegisterHit = NetModule and (NetModule:FindFirstChild("RegisterHit") or NetModule:FindFirstChild("RE/RegisterHit"))

-- [[ Physics Anchor ]] --
local function EnsurePhysicsAnchor()
    if not RootPart then return end
    if not BodyVel or BodyVel.Parent ~= RootPart then
        if BodyVel then BodyVel:Destroy() end
        BodyVel = Instance.new("BodyVelocity")
        BodyVel.Name = "OnyxAnchor"
        BodyVel.Velocity = Vector3.new(0, 0, 0)
        BodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        BodyVel.P = 2000
        BodyVel.Parent = RootPart
    end
end

local function RemovePhysicsAnchor()
    if BodyVel then
        BodyVel:Destroy()
        BodyVel = nil
    end
end

-- [[ Stepped Noclip ]] --
RunService.Stepped:Connect(function()
    if Config.Enabled and Character then
        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        if RootPart then
            RootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            RootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end
end)

LocalPlayer.CharacterAdded:Connect(function(char)
    Character = char
    RootPart = char:WaitForChild("HumanoidRootPart")
    Humanoid = char:WaitForChild("Humanoid")
    task.wait(0.5)
    EnsurePhysicsAnchor()
    SetupCombatHooks()
end)

function SetupCombatHooks()
    pcall(function()
        local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
        if playerScripts and playerScripts:FindFirstChild("CombatFramework") then
            CombatFramework = require(playerScripts.CombatFramework)
            ActiveController = CombatFramework.activeController
        end
    end)
end
SetupCombatHooks()

-- [[ Auto Enable PvP & Buso Haki ]] --
local function EnsurePvPAndHaki()
    if not Character then return end
    pcall(function()
        if Config.AutoPvP and CommF then
            if Character:FindFirstChild("PvPDisabled") then
                CommF:InvokeServer("EnablePvp")
            end
        end
        if Config.AutoHaki and CommF then
            if not Character:FindFirstChild("HasBuso") then
                CommF:InvokeServer("Buso")
            end
        end
    end)
end

-- [[ SafeZone Cache ]] --
local SafeZones = {}
for _, obj in ipairs(Workspace:GetDescendants()) do
    if obj:IsA("BasePart") and (obj.Name:lower():find("safezone") or obj.Name:lower():find("peace") or obj.Name == "SafeZone") then
        table.insert(SafeZones, obj)
    end
end

local function IsInSafeZone(pos)
    for _, zone in ipairs(SafeZones) do
        if zone and zone.Parent then
            local rel = zone.CFrame:PointToObjectSpace(pos)
            local sz = zone.Size / 2
            if math.abs(rel.X) <= sz.X + 4 and math.abs(rel.Y) <= sz.Y + 4 and math.abs(rel.Z) <= sz.Z + 4 then
                return true
            end
        end
    end
    return false
end

-- [[ Target Validity Check ]] --
local function IsTargetAliveAndValid(player)
    if not player or not player.Parent or player == LocalPlayer then return false end
    
    -- Check Blacklist expiration
    if BlacklistedTargets[player] then
        if tick() < BlacklistedTargets[player] then
            return false
        else
            BlacklistedTargets[player] = nil
        end
    end

    local char = player.Character
    if not char then return false end

    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return false end

    if char:FindFirstChildOfClass("ForceField") then return false end
    if char:FindFirstChild("PvPDisabled") or player:FindFirstChild("PvPDisabled") then return false end
    if IsInSafeZone(hrp.Position) then return false end

    return true
end

-- [[ Hard Target Selector (Only runs when CurrentTarget is nil) ]] --
local function AcquireNextTarget()
    local best = nil
    local shortestDist = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if IsTargetAliveAndValid(p) then
            local hrp = p.Character.HumanoidRootPart
            local dist = (RootPart.Position - hrp.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                best = p
            end
        end
    end
    return best
end

-- [[ Weapon Rotator ]] --
local function SwitchToNextWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack or not Character or not Humanoid then return end

    local category = Config.Weapons[CurrentWeaponIndex]
    local targetTool = nil

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local tType = tool:GetAttribute("WeaponType") or tool.ToolTip
            if tType == category or tool.Name:lower():find(category:lower()) or (category == "Melee" and (tool:FindFirstChild("CombatScript") or tool.ToolTip == "Melee")) then
                targetTool = tool
                break
            end
        end
    end

    if targetTool then
        Humanoid:EquipTool(targetTool)
    end

    CurrentWeaponIndex = (CurrentWeaponIndex % #Config.Weapons) + 1
end

-- [[ Fast Attack Engine ]] --
local function ExecuteFastAttack(targetHRP)
    if not Config.FastAttack or not targetHRP then return end

    pcall(function()
        if not ActiveController then SetupCombatHooks() end
        if ActiveController then
            ActiveController.timeToNextAttack = 0
            ActiveController.attacking = false
            ActiveController.blocking = false
            ActiveController.hitboxMagnitude = 90
            ActiveController.increment = 3
            if ActiveController.attack then ActiveController:attack() end
            if ActiveController.bladeHit then ActiveController.bladeHit(targetHRP, {targetHRP}) end
        end
    end)

    pcall(function()
        if RegisterAttack then RegisterAttack:FireServer(0) end
        if RegisterHit then RegisterHit:FireServer(targetHRP, {{targetHRP.Parent, targetHRP}}) end
    end)

    local currentTool = Character:FindFirstChildOfClass("Tool")
    if currentTool then currentTool:Activate() end
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))
end

-- [[ Skill Cast Engine ]] --
local function FireSkills(targetHRP, targetHum)
    if not Config.SkillSpam or not targetHRP or targetHum.Health <= 0 then return end
    pcall(function()
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHRP.Position)
    end)

    for _, key in ipairs(Config.Skills) do
        if not CurrentTarget or targetHum.Health <= 0 then break end
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
        task.wait(0.03)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
        task.wait(0.05)
    end
end

-- [[ Direct Overhead Flight (Straight Path, No Orbit) ]] --
local function FlyDirectToTarget(targetHRP)
    EnsurePhysicsAnchor()
    
    local targetOverheadPos = targetHRP.Position + Vector3.new(0, Config.OverheadDistance, 0)
    local targetCFrame = CFrame.new(targetOverheadPos, targetHRP.Position) * CFrame.Angles(math.rad(-90), 0, 0)
    
    local currentPos = RootPart.Position
    local dist = (currentPos - targetOverheadPos).Magnitude

    if dist > 35 then
        -- พุ่งตรงความเร็วสูง ไม่มีเลี้ยววน
        local moveStep = math.clamp((Config.FlySpeed * 0.02) / dist, 0, 1)
        RootPart.CFrame = CFrame.new(currentPos:Lerp(targetOverheadPos, moveStep), targetHRP.Position)
    else
        -- ล็อคตายบนหัวเป้าหมาย
        RootPart.CFrame = targetCFrame
    end
end

-- [[ Master Combat Loop (Hard Sticky Lock Engine) ]] --
task.spawn(function()
    while true do
        task.wait(0.015)
        
        if Config.Enabled then
            EnsurePvPAndHaki()

            -- ตรวจสอบว่าเป้าหมายปัจจุบันยังเล่นอยู่ / มีชีวิตอยู่ / ยังไม่ตาย
            if not CurrentTarget or not IsTargetAliveAndValid(CurrentTarget) then
                CurrentTarget = AcquireNextTarget()
                CombatTracker.Target = CurrentTarget
                CombatTracker.EngagedTick = 0
                CombatTracker.LastKnownHP = 0
            end

            -- ทำการโจมตีเป้าหมายที่ล็อคไว้
            if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
                local tHRP = CurrentTarget.Character.HumanoidRootPart
                local tHum = CurrentTarget.Character:FindFirstChild("Humanoid")

                if tHum and tHum.Health > 0 then
                    -- พุ่งตรงไปหาเป้าหมาย
                    FlyDirectToTarget(tHRP)

                    local dist = (RootPart.Position - tHRP.Position).Magnitude
                    
                    -- เมื่อเข้าถึงระยะโจมตี
                    if dist <= (Config.OverheadDistance + 15) then
                        -- เริ่มนับเวลาทำดาเมจ
                        if CombatTracker.EngagedTick == 0 then
                            CombatTracker.EngagedTick = tick()
                            CombatTracker.LastKnownHP = tHum.Health
                        else
                            -- ตรวจสอบว่าดาเมจเข้าหรือไม่
                            if (tick() - CombatTracker.EngagedTick) >= Config.CombatDamageTimeout then
                                if tHum.Health >= CombatTracker.LastKnownHP then
                                    -- ตีไม่เข้าเลยในเวลาที่กำหนด -> แบนเป้าหมายนี้ทันทีแล้วเปลี่ยนตัว
                                    BlacklistedTargets[CurrentTarget] = tick() + Config.BlacklistDuration
                                    CurrentTarget = nil
                                    CombatTracker.Target = nil
                                    CombatTracker.EngagedTick = 0
                                else
                                    -- เลือดลดปกติ รีเซ็ตเวลาตรวจจับ
                                    CombatTracker.EngagedTick = tick()
                                    CombatTracker.LastKnownHP = tHum.Health
                                end
                            end
                        end

                        if CurrentTarget then
                            -- สลับอาวุธตามลูป
                            if tick() - LastWeaponSwitch >= Config.WeaponSwitchDelay then
                                SwitchToNextWeapon()
                                LastWeaponSwitch = tick()
                            end

                            -- ตีธรรมดา + สกิล
                            ExecuteFastAttack(tHRP)
                            FireSkills(tHRP, tHum)
                        end
                    else
                        -- ยังบินไปไม่ถึง ไม่นับเวลา timeout
                        CombatTracker.EngagedTick = 0
                    end
                else
                    -- เป้าหมายตาย ล็อคเป้าใหม่
                    CurrentTarget = nil
                end
            end
        else
            RemovePhysicsAnchor()
            CurrentTarget = nil
        end
    end
end)


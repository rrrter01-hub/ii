-- [[ Blox Fruits Auto-Skip Non-PvP & Laser Bounty Hunter v68 ]] --
-- Features: Non-PvP Pre-Filter, 1.5s In-Range Damage Watchdog (Auto-Skip), Butter-Smooth Flight, Overhead AimLock

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local VirtualInputManager = game:GetService("VirtualInputManager")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")
local Humanoid = Character:WaitForChild("Humanoid")

-- [[ Master Configuration ]] --
local Config = {
    Enabled = false,
    OverheadDistance = 11,   -- ความสูงเหนือหัวเป้าหมาย (studs)
    FlySpeed = 350,          -- ความเร็วบินพุ่ง (studs/s)
    DamageTimeout = 1.5,     -- ตีถึงตัว 1.5 วิ เลือดไม่ลด = ปิด PvP -> สลับตัวทันที!
    BlacklistTime = 60,      -- แบนตัวที่ไม่เปิด PvP 60 วินาที
    FastAttack = true,
    AutoHaki = true,
    SkillSpam = true,
    Skills = {"Z", "X", "C", "V"},
    Weapons = {"Melee", "Sword", "Blox Fruit"}
}

local CurrentTarget = nil
local Blacklist = {} -- [Player] = ExpireTime
local FlightVelocity = nil
local CombatFramework = nil
local ActiveController = nil

-- Watchdog Trackers
local InCombatRange = false
local CombatStartTimer = 0
local InitialRecordedHealth = nil

-- [[ Pure Physics Flight Engine ]] --
local function EnsureFlightEngine()
    if not RootPart then return end
    if not FlightVelocity or FlightVelocity.Parent ~= RootPart then
        if FlightVelocity then FlightVelocity:Destroy() end
        FlightVelocity = Instance.new("BodyVelocity")
        FlightVelocity.Name = "OnyxSmoothVelocity"
        FlightVelocity.Velocity = Vector3.new(0, 0, 0)
        FlightVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        FlightVelocity.P = 10000
        FlightVelocity.Parent = RootPart
    end
end

local function StopFlightEngine()
    if FlightVelocity then
        FlightVelocity:Destroy()
        FlightVelocity = nil
    end
end

-- [[ Clean Noclip ]] --
RunService.Stepped:Connect(function()
    if Config.Enabled and Character then
        for _, part in ipairs(Character:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

-- Character Refresh
LocalPlayer.CharacterAdded:Connect(function(char)
    Character = char
    RootPart = char:WaitForChild("HumanoidRootPart")
    Humanoid = char:WaitForChild("Humanoid")
    task.wait(0.5)
    EnsureFlightEngine()
end)

-- [[ Hook Combat Framework ]] --
pcall(function()
    local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
    if playerScripts and playerScripts:FindFirstChild("CombatFramework") then
        CombatFramework = require(playerScripts.CombatFramework)
        ActiveController = CombatFramework.activeController
    end
end)

-- [[ Auto Buso Haki ]] --
local function CheckHaki()
    if not Config.AutoHaki or not Character then return end
    if not Character:FindFirstChild("HasBuso") then
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local commF = remotes and remotes:FindFirstChild("CommF_")
        if commF then
            commF:InvokeServer("Buso")
        end
    end
end

-- [[ SafeZone Cache ]] --
local SafeZones = {}
for _, obj in ipairs(Workspace:GetDescendants()) do
    if (obj.Name == "SafeZone" or obj.Name:lower():find("safezone")) and obj:IsA("BasePart") then
        table.insert(SafeZones, obj)
    end
end

local function IsInSafeZone(pos)
    for _, zone in ipairs(SafeZones) do
        if zone and zone.Parent then
            local rel = zone.CFrame:PointToObjectSpace(pos)
            local sz = zone.Size / 2
            if math.abs(rel.X) <= sz.X and math.abs(rel.Y) <= sz.Y and math.abs(rel.Z) <= sz.Z then
                return true
            end
        end
    end
    return false
end

-- [[ Strict PvP & Target Filter ]] --
local function IsValidPvPTarget(player)
    if not player or player == LocalPlayer or not player.Parent then return false end
    
    -- Check Blacklist (พวกปิด PvP หรืออยู่ในเซฟ)
    if Blacklist[player] and tick() < Blacklist[player] then return false end

    local char = player.Character
    if not char then return false end

    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return false end

    -- 1. Shield & PvP Disabled Tags
    if char:FindFirstChildOfClass("ForceField") or char:FindFirstChild("SafeZoneShield") or char:FindFirstChild("PvPDisabled") then
        return false
    end

    -- 2. Blox Fruits Data Folder Check
    local data = player:FindFirstChild("Data")
    if data then
        if data:FindFirstChild("PvP") and data.PvP.Value == false then
            return false
        end
        if data:FindFirstChild("Level") and data.Level.Value < 20 then
            return false
        end
    end

    -- 3. SafeZone Location Check
    if IsInSafeZone(hrp.Position) then
        return false
    end

    return true
end

-- [[ Skip & Blacklist Target ]] --
local function SkipCurrentTarget(reason)
    if CurrentTarget then
        Blacklist[CurrentTarget] = tick() + Config.BlacklistTime
        print(string.format("[Hunter Watchdog] ⏩ Skipped Target '%s': %s (Blacklisted %ds)", CurrentTarget.Name, reason or "Non-PvP", Config.BlacklistTime))
    end
    CurrentTarget = nil
    InCombatRange = false
    CombatStartTimer = 0
    InitialRecordedHealth = nil
end

-- [[ Target Selector ]] --
local function GetBestTarget()
    -- Clear Expired Blacklist
    local now = tick()
    for p, expire in pairs(Blacklist) do
        if now >= expire then Blacklist[p] = nil end
    end

    local best = nil
    local shortest = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if IsValidPvPTarget(p) then
            local dist = (RootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
            if dist < shortest then
                shortest = dist
                best = p
            end
        end
    end
    return best
end

-- [[ Auto Equip Weapon ]] --
local function EquipPreferredWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack or not Character then return end

    if not Character:FindFirstChildOfClass("Tool") then
        for _, category in ipairs(Config.Weapons) do
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then
                    local tType = tool:GetAttribute("WeaponType") or tool.ToolTip
                    if tType == category or tool.Name:lower():find(category:lower()) or (category == "Melee" and tool:FindFirstChild("CombatScript")) then
                        Humanoid:EquipTool(tool)
                        return
                    end
                end
            end
        end
    end
end

-- [[ AimLock Camera ]] --
local function AimAtTarget(targetPosition)
    Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPosition)
end

-- [[ Real Fast Attack Registration ]] --
local function ExecuteFastAttack()
    if not Config.FastAttack then return end

    if ActiveController and ActiveController.attack then
        pcall(function()
            ActiveController.timeToNextAttack = 0
            ActiveController.hitboxMagnitude = 75
            ActiveController:attack()
        end)
    end

    local currentTool = Character:FindFirstChildOfClass("Tool")
    if currentTool then
        currentTool:Activate()
    end
    
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))

    local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
    if net and net:FindFirstChild("RegisterAttack") then
        net.RegisterAttack:FireServer(0)
    end
end

-- [[ Butter-Smooth Flight Movement ]] --
local function SmoothFlight(targetHRP)
    EnsureFlightEngine()
    
    local targetOverheadPos = targetHRP.Position + Vector3.new(0, Config.OverheadDistance, 0)
    local currentPos = RootPart.Position
    local direction = (targetOverheadPos - currentPos)
    local distance = direction.Magnitude

    if distance > 15 then
        -- 🚀 LASER FLIGHT: พุ่งตรงแบบ 60 FPS
        FlightVelocity.Velocity = direction.Unit * Config.FlySpeed
        InCombatRange = false
    else
        -- 🎯 OVERHEAD LOCK: ลอยนิ่งเหนือหัว Y+11
        FlightVelocity.Velocity = Vector3.new(0, 0, 0)
        RootPart.CFrame = CFrame.new(targetOverheadPos, targetHRP.Position)
    end
end

-- [[ THREAD 1: Continuous M1 Fast Attack ]] --
task.spawn(function()
    while true do
        task.wait(0.02)
        if Config.Enabled and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
            local tHRP = CurrentTarget.Character.HumanoidRootPart
            local dist = (RootPart.Position - tHRP.Position).Magnitude
            if dist <= (Config.OverheadDistance + 14) then
                EquipPreferredWeapon()
                AimAtTarget(tHRP.Position)
                ExecuteFastAttack()
            end
        end
    end
end)

-- [[ THREAD 2: Parallel Skills AimLock ]] --
task.spawn(function()
    while true do
        task.wait(0.08)
        if Config.Enabled and Config.SkillSpam and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
            local tHRP = CurrentTarget.Character.HumanoidRootPart
            local tHum = CurrentTarget.Character:FindFirstChild("Humanoid")
            local dist = (RootPart.Position - tHRP.Position).Magnitude

            if dist <= (Config.OverheadDistance + 14) and tHum and tHum.Health > 0 then
                for _, key in ipairs(Config.Skills) do
                    if not Config.Enabled or not CurrentTarget or tHum.Health <= 0 then break end
                    AimAtTarget(tHRP.Position)
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
                    task.wait(0.04)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
                    task.wait(0.12)
                end
            end
        end
    end
end)

-- [[ Master Navigation & 1.5s Non-PvP Auto-Skip Watchdog ]] --
task.spawn(function()
    while true do
        task.wait(0.02)
        
        if Config.Enabled then
            -- Validate Target
            if not CurrentTarget or not IsValidPvPTarget(CurrentTarget) then
                if CurrentTarget then
                    SkipCurrentTarget("Target invalid / entered SafeZone")
                end
                CurrentTarget = GetBestTarget()
                InCombatRange = false
                CombatStartTimer = 0
                InitialRecordedHealth = nil
            end

            if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
                local tHRP = CurrentTarget.Character.HumanoidRootPart
                local tHum = CurrentTarget.Character:FindFirstChild("Humanoid")
                
                -- Smooth Gliding to Target
                SmoothFlight(tHRP)
                CheckHaki()

                -- [[ 1.5s NON-PVP AUTO-SKIP WATCHDOG ]] --
                local dist = (RootPart.Position - tHRP.Position).Magnitude
                if dist <= (Config.OverheadDistance + 14) and tHum then
                    if not InCombatRange then
                        -- เพิ่งบินมาถึงหัวเป้าหมาย: เริ่มจับเวลาดาเมจ
                        InCombatRange = true
                        CombatStartTimer = tick()
                        InitialRecordedHealth = tHum.Health
                    else
                        -- ถึงหัวแล้วเกิน 1.5 วินาที: ตรวจสอบเลือด
                        if tick() - CombatStartTimer >= Config.DamageTimeout then
                            if tHum.Health >= InitialRecordedHealth then
                                -- เลือดไม่ลด = ปิด PvP / อยู่ในโซนอมเลือด -> ข้ามไปหาตัวอื่นทันที!
                                SkipCurrentTarget("Non-PvP / Zero Damage Detected")
                            else
                                -- ตีเข้าปกติ -> รีเฟรชเลือดแล้วล่าต่อจนตาย
                                InitialRecordedHealth = tHum.Health
                                CombatStartTimer = tick()
                            end
                        end
                    end
                end
            end
        else
            StopFlightEngine()
        end
    end
end)


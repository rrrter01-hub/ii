-- [[ Blox Fruits Butter-Smooth Velocity Bounty Hunter v68 ]] --
-- Fixes: Removed CFrame/Physics Conflict, Zero-Stutter Laser Flight, Clean Noclip Penetration

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local VirtualInputManager = game:GetService("VirtualInputManager")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")
local Humanoid = Character:WaitForChild("Humanoid")

-- [[ Master Configuration ]] --
local Config = {
    Enabled = false,
    OverheadDistance = 11,   -- ความสูงเหนือหัวเปase (studs)
    FlySpeed = 350,          -- ความเร็วบินพุ่ง (studs/s)
    FastAttack = true,
    AutoHaki = true,
    SkillSpam = true,
    Skills = {"Z", "X", "C", "V"},
    Weapons = {"Melee", "Sword", "Blox Fruit"}
}

local CurrentTarget = nil
local FlightVelocity = nil
local CombatFramework = nil
local ActiveController = nil

-- [[ Pure Physics Flight Engine (No CFrame Overwrite During Flight) ]] --
local function EnsureFlightEngine()
    if not RootPart then return end
    if not FlightVelocity or FlightVelocity.Parent ~= RootPart then
        if FlightVelocity then FlightVelocity:Destroy() end
        FlightVelocity = Instance.new("BodyVelocity")
        FlightVelocity.Name = "OnyxSmoothVelocity"
        FlightVelocity.Velocity = Vector3.new(0, 0, 0)
        FlightVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        FlightVelocity.P = 10000
        FlightVelocity.Parent = RootPart
    end
end

local function StopFlightEngine()
    if FlightVelocity then
        FlightVelocity:Destroy()
        FlightVelocity = nil
    end
end

-- [[ Clean Noclip (ทะลุทุกสิ่งกีดขวางแบบสมบูรณ์) ]] --
RunService.Stepped:Connect(function()
    if Config.Enabled and Character then
        for _, part in ipairs(Character:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

-- Character Refresh
LocalPlayer.CharacterAdded:Connect(function(char)
    Character = char

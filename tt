-- [[ THREAD 3: TIER 3 FAIL-FAST DAMAGE WATCHDOG & MOVEMENT ]] --
task.spawn(function()
    while true do
        task.wait(0.02)

        if Config.Enabled then
            CheckPvPAndHaki()

            -- 1. Check if current target is still valid
            if not CurrentTarget or not IsValidTarget(CurrentTarget) then
                if CurrentTarget then
                    DropAndBlacklist(CurrentTarget, "Ran into SafeZone / PvP Disabled")
                end
                CurrentTarget = AcquireBestTarget()
                if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                    TargetHealthTracker = CurrentTarget.Character.Humanoid.Health
                    AttackStartTimestamp = tick()
                end
            end

            -- 2. Execute Overhead Lock & Damage Watchdog
            if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
                local tHRP = CurrentTarget.Character.HumanoidRootPart
                local tHum = CurrentTarget.Character:FindFirstChild("Humanoid")

                -- Real-time SafeZone Check
                if IsPositionInAnySafeZone(tHRP.Position) then
                    DropAndBlacklist(CurrentTarget, "Target is inside SafeZone Boundary")
                else
                    MaintainAnchor()

                    -- Overhead Lock (Y + 10 studs)
                    local overheadCFrame = CFrame.new(tHRP.Position + Vector3.new(0, Config.OverheadDistance, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
                    local curPos = RootPart.Position
                    local targetPos = overheadCFrame.Position
                    local dist = (curPos - targetPos).Magnitude

                    if dist > 120 then
                        RootPart.CFrame = CFrame.new(curPos:Lerp(targetPos, (Config.FlySpeed * 0.02) / dist))
                    else
                        RootPart.CFrame = overheadCFrame
                    end

                    -- [[ WATCHDOG PROBE: Did health drop within 1.2s? ]] --
                    if dist <= (Config.OverheadDistance + 12) then
                        if TargetHealthTracker and (tick() - AttackStartTimestamp >= Config.DamageTimeout) then
                            if tHum.Health >= TargetHealthTracker then
                                -- DAMAGE FAILED TO REGISTER -> ENEMY IS IMMUNE / IN SAFEZONE!
                                DropAndBlacklist(CurrentTarget, "Damage Unregistered (SafeZone / Invincible)")
                            else
                                -- Damage registered successfully! Update baseline
                                TargetHealthTracker = tHum.Health
                                AttackStartTimestamp = tick()
                            end
                        end
                    else
                        -- Reset timer while still flying to target
                        AttackStartTimestamp = tick()
                    end
                end
            end
        else
            ClearAnchor()
        end
    end
end)


-- [[ Dynamic SafeZone World Parts ]] --
local DynamicSafeZones = {}
for _, obj in ipairs(Workspace:GetDescendants()) do
    if obj:IsA("BasePart") then
        local n = obj.Name:lower()
        if n:find("safezone") or n:find("peace") or n:find("safe_zone") or n == "safezone" then
            table.insert(DynamicSafeZones, obj)
        end
    end
end

-- [[ Layer 1 & 2: Complete SafeZone Scanner ]] --
local function IsPositionInSafeZone(pos)
    -- Check Dynamic Parts
    for _, zone in ipairs(DynamicSafeZones) do
        if zone and zone.Parent then
            local rel = zone.CFrame:PointToObjectSpace(pos)
            local sz = zone.Size / 2
            if math.abs(rel.X) <= sz.X + 6 and math.abs(rel.Y) <= sz.Y + 6 and math.abs(rel.Z) <= sz.Z + 6 then
                return true
            end
        end
    end

    -- Check Known High-Traffic Safe Regions
    for _, reg in ipairs(KnownSafeRegions) do
        if (pos - reg.Center).Magnitude <= reg.Radius then
            return true
        end
    end

    return false
end

-- [[ Layer 3: Advanced Player PvP & Vulnerability Parser ]] --
local function IsPlayerKillable(player)
    if not player or not player.Parent or player == LocalPlayer then return false end
    
    -- Check Blacklist Expiration
    if BlacklistedTargets[player] then
        if tick() < BlacklistedTargets[player] then
            return false
        else
            BlacklistedTargets[player] = nil
        end
    end

    local char = player.Character
    if not char then return false end

    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    if not hum or not hrp or hum.Health <= 0 then return false end

    -- 1. ForceField Check (Spawn / Invulnerability bubble)
    if char:FindFirstChildOfClass("ForceField") then return false end

    -- 2. Attribute Checks (Player & Character)
    if char:GetAttribute("SafeZone") == true or char:GetAttribute("InSafeZone") == true or char:GetAttribute("PvPDisabled") == true then
        return false
    end
    if player:GetAttribute("SafeZone") == true or player:GetAttribute("PvPDisabled") == true then
        return false
    end

    -- 3. Child Value Checks
    if char:FindFirstChild("PvPDisabled") or char:FindFirstChild("SafeZone") or char:FindFirstChild("NoPvP") then
        return false
    end
    if player:FindFirstChild("PvPDisabled") then
        return false
    end

    -- 4. Overhead Billboard GUI Scan (Check Head text/icons for "PvP Off" or SafeZone symbols)
    if head then
        for _, gui in ipairs(head:GetDescendants()) do
            if gui:IsA("TextLabel") then
                local txt = gui.Text:lower()
                if txt:find("pvp off") or txt:find("disabled") or txt:find("safe") or txt:find("peace") then
                    return false
                end
            elseif gui:IsA("ImageLabel") and gui.Visible then
                local img = gui.Image:lower()
                if img:find("shield") or img:find("peace") or img:find("safe") then
                    return false
                end
            end
        end
    end

    -- 5. Physical Position in SafeZone
    if IsPositionInSafeZone(hrp.Position) then
        return false
    end

    return true
end

-- [[ Target Selector ]] --
local function GetNextKillableTarget()
    local best = nil
    local shortestDist = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if IsPlayerKillable(p) then
            local hrp = p.Character.HumanoidRootPart
            local dist = (RootPart.Position - hrp.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                best = p
            end
        end
    end
    return best
end

-- [[ Fast Weapon Switcher ]] --
local function SwitchWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack or not Character or not Humanoid then return end

    local category = Config.Weapons[CurrentWeaponIndex]
    local targetTool = nil

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local tType = tool:GetAttribute("WeaponType") or tool.ToolTip
            if tType == category or tool.Name:lower():find(category:lower()) or (category == "Melee" and (tool:FindFirstChild("CombatScript") or tool.ToolTip == "Melee")) then
                targetTool = tool
                break
            end
        end
    end

    if targetTool then
        Humanoid:EquipTool(targetTool)
    end

    CurrentWeaponIndex = (CurrentWeaponIndex % #Config.Weapons) + 1
end

-- [[ Combat Fast Attack Engine ]] --
local function ExecuteFastAttack(targetHRP)
    if not Config.FastAttack or not targetHRP then return end

    pcall(function()
        if not ActiveController then SetupCombatHooks() end
        if ActiveController then
            ActiveController.timeToNextAttack = 0
            ActiveController.attacking = false
            ActiveController.blocking = false
            ActiveController.hitboxMagnitude = 100
            ActiveController.increment = 3
            if ActiveController.attack then ActiveController:attack() end
            if ActiveController.bladeHit then ActiveController.bladeHit(targetHRP, {targetHRP}) end
        end
    end)

    pcall(function()
        if RegisterAttack then RegisterAttack:FireServer(0) end
        if RegisterHit then RegisterHit:FireServer(targetHRP, {{targetHRP.Parent, targetHRP}}) end
    end)

    local currentTool = Character:FindFirstChildOfClass("Tool")
    if currentTool then currentTool:Activate() end
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))
end

-- [[ Skill Cast Engine ]] --
local function CastSkills(targetHRP, targetHum)
    if not Config.SkillSpam or not targetHRP or targetHum.Health <= 0 then return end
    pcall(function()
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHRP.Position)
    end)

    for _, key in ipairs(Config.Skills) do
        if not CurrentTarget or targetHum.Health <= 0 then break end
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
        task.wait(0.02)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
        task.wait(0.04)
    end
end

-- [[ Direct High-Speed Overhead Flight ]] --
local function FlyDirect(targetHRP)
    EnsurePhysicsAnchor()
    local targetPos = targetHRP.Position + Vector3.new(0, Config.OverheadDistance, 0)
    local targetCF = CFrame.new(targetPos, targetHRP.Position) * CFrame.Angles(math.rad(-90), 0, 0)
    
    local curPos = RootPart.Position
    local dist = (curPos - targetPos).Magnitude

    if dist > 30 then
        local step = math.clamp((Config.FlySpeed * 0.02) / dist, 0, 1)
        RootPart.CFrame = CFrame.new(curPos:Lerp(targetPos, step), targetHRP.Position)
    else
        RootPart.CFrame = targetCF
    end
end

-- [[ Layer 4: Instant Damage Probe Combat Loop ]] --
task.spawn(function()
    while true do
        task.wait(0.015)
        
        if Config.Enabled then
            EnsurePvPAndHaki()

            -- ตรวจสอบความถูกต้องของเป้าหมาย
            if not CurrentTarget or not IsPlayerKillable(CurrentTarget) then
                CurrentTarget = GetNextKillableTarget()
                ProbeState.Player = CurrentTarget
                ProbeState.IsTesting = false
                ProbeState.StartTick = 0
                ProbeState.StartHP = 0
            end

            if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
                local tHRP = CurrentTarget.Character.HumanoidRootPart
                local tHum = CurrentTarget.Character:FindFirstChild("Humanoid")

                if tHum and tHum.Health > 0 then
                    -- บินตรงปักหัวเป้าหมาย
                    FlyDirect(tHRP)

                    local dist = (RootPart.Position - tHRP.Position).Magnitude

                    -- เมื่อเข้าถึงระยะโจมตี (11 + 15 studs)
                    if dist <= (Config.OverheadDistance + 15) then
                        -- โหมดทดสอบดาเมจ (Instant Damage Probe)
                        if not ProbeState.IsTesting or ProbeState.Player ~= CurrentTarget then
                            ProbeState.Player = CurrentTarget
                            ProbeState.IsTesting = true
                            ProbeState.StartTick = tick()
                            ProbeState.StartHP = tHum.Health
                        else
                            -- ทำการทดสอบดาเมจครบ 0.8 วินาที
                            if (tick() - ProbeState.StartTick) >= Config.DamageProbeTimeout then
                                if tHum.Health >= ProbeState.StartHP then
                                    -- ดาเมจไม่เข้าเลย = ติดเซฟโซนแฝง / ปิด PvP อยู่ -> แบน 90 วิ และเปลี่ยนเป้าหมายทันที!
                                    BlacklistedTargets[CurrentTarget] = tick() + Config.BlacklistDuration
                                    CurrentTarget = nil
                                    ProbeState.IsTesting = false
                                    ProbeState.Player = nil
                                else
                                    -- ดาเมจเข้าปกติ ทำการล่าต่อ และอัปเดตเลือดปัจจุบัน
                                    ProbeState.StartTick = tick()
                                    ProbeState.StartHP = tHum.Health
                                end
                            end
                        end

                        if CurrentTarget then
                            if tick() - LastWeaponSwitch >= Config.WeaponSwitchDelay then
                                SwitchWeapon()
                                LastWeaponSwitch = tick()
                            end

                            ExecuteFastAttack(tHRP)
                            CastSkills(tHRP, tHum)
                        end
                    else
                        ProbeState.IsTesting = false
                    end
                else
                    -- เป้าหมายตาย ล็อคตัวถัดไป
                    CurrentTarget = nil
                    ProbeState.IsTesting = false
                end
            end
        else
            RemovePhysicsAnchor()
            CurrentTarget = nil
            ProbeState.IsTesting = false
        end
    end
end)


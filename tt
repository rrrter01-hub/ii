-- Features: Dynamic SafeZone Raycast/BoundingBox Check, Strict PvP Validation, Auto Target Skipping & Blacklist

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local VirtualInputManager = game:GetService("VirtualInputManager")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")
local Humanoid = Character:WaitForChild("Humanoid")

-- [[ Configuration & States ]] --
local Settings = {
    AutoBounty = false,
    FastAttack = true,
    AutoHaki = true,
    TargetPvPOnly = true,
    StrictSafeZoneCheck = true,
    SkipStuckTargets = true,
    TargetTimeout = 3.5, -- วินาทีสูงสุดในการตี ถ้าเลือดไม่ลดจะข้ามทันที
    BlacklistDuration = 20, -- พักตัวที่ไม่สามารถตีได้ 20 วินาที
    TweenSpeed = 350,
    AttackDistance = 4,
    WeaponSequence = {"Melee", "Blox Fruit", "Sword", "Gun"},
    Skills = {"Z", "X", "C", "V"}
}

local CurrentTarget = nil
local CurrentTween = nil
local BlacklistedPlayers = {} -- [Player] = ExpireTimestamp
local TargetInitialHealth = nil
local TargetLockTime = 0

-- Character Lifecycle
LocalPlayer.CharacterAdded:Connect(function(char)
    Character = char
    RootPart = char:WaitForChild("HumanoidRootPart")
    Humanoid = char:WaitForChild("Humanoid")
end)

-- [[ Cache SafeZone Locations ]] --
local SafeZoneParts = {}
local function CacheSafeZones()
    table.clear(SafeZoneParts)
    
    local worldOrigin = Workspace:FindFirstChild("_WorldOrigin")
    if worldOrigin and worldOrigin:FindFirstChild("SafeZones") then
        for _, zone in ipairs(worldOrigin.SafeZones:GetChildren()) do
            if zone:IsA("BasePart") then
                table.insert(SafeZoneParts, zone)
            end
        end
    end
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name:lower():find("safezone") and obj:IsA("BasePart") then
            if not table.find(SafeZoneParts, obj) then
                table.insert(SafeZoneParts, obj)
            end
        end
    end
end
CacheSafeZones()

-- [[ Strict SafeZone Detection (Bounding Box & Proximity) ]] --
local function IsPositionInSafeZone(pos)
    if not Settings.StrictSafeZoneCheck then return false end
    
    for _, zone in ipairs(SafeZoneParts) do
        if zone and zone.Parent then
            local relative = zone.CFrame:PointToObjectSpace(pos)
            local size = zone.Size / 2
            
            -- Point In Box Check
            if math.abs(relative.X) <= size.X and math.abs(relative.Y) <= size.Y and math.abs(relative.Z) <= size.Z then
                return true
            end
            
            -- Radius fallback for spherical / mesh safezones
            if (zone.Position - pos).Magnitude <= (zone.Size.Magnitude / 2) then
                return true
            end
        end
    end
    return false
end

-- [[ Comprehensive Target Validator ]] --
local function IsValidPvPTarget(player)
    if player == LocalPlayer or not player or not player.Parent then return false end
    
    -- Blacklist Check
    if BlacklistedPlayers[player] and tick() < BlacklistedPlayers[player] then
        return false
    end
    
    local char = player.Character
    if not char then return false end
    
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return false end
    
    -- 1. ForceField / Spawn Shield
    if char:FindFirstChildOfClass("ForceField") then return false end
    
    -- 2. PvP Flags Check
    if Settings.TargetPvPOnly then
        if char:FindFirstChild("PvPDisabled") or char:FindFirstChild("SafeZoneShield") then
            return false
        end
        
        local data = player:FindFirstChild("Data")
        if data and data:FindFirstChild("PvP") and data.PvP.Value == false then
            return false
        end
    end
    
    -- 3. Strict Map SafeZone Location Check
    if IsPositionInSafeZone(hrp.Position) then
        return false
    end
    
    return true
end

-- [[ Dynamic Target Selector with Priority ]] --
local function AcquireNextTarget()
    -- Clean expired blacklist
    local now = tick()
    for p, expire in pairs(BlacklistedPlayers) do
        if now >= expire then
            BlacklistedPlayers[p] = nil
        end
    end

    local bestTarget = nil
    local lowestDist = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if IsValidPvPTarget(p) then
            local dist = (RootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
            if dist < lowestDist then
                lowestDist = dist
                bestTarget = p
            end
        end
    end

    return bestTarget
end

-- [[ Blacklist Target Helper ]] --
local function BlacklistCurrentTarget(reason)
    if CurrentTarget then
        BlacklistedPlayers[CurrentTarget] = tick() + Settings.BlacklistDuration
        print(string.format("[Onyx Hunter] Skipped & Blacklisted '%s': %s", CurrentTarget.Name, reason or "Invalid Target"))
        CurrentTarget = nil
        TargetInitialHealth = nil
        if CurrentTween then CurrentTween:Cancel() end
    end
end

-- [[ Auto Buso Haki ]] --
local function EnsureHaki()
    if not Settings.AutoHaki or not Character then return end
    if not Character:FindFirstChild("HasBuso") then
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local commF = remotes and remotes:FindFirstChild("CommF_")
        if commF then
            commF:InvokeServer("Buso")
        end
    end
end

-- [[ Weapon Equipper ]] --
local function EquipWeapon(category)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack or not Character then return end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local toolType = tool:GetAttribute("WeaponType") or tool.ToolTip
            if toolType == category or tool.Name:lower():find(category:lower()) or (category == "Melee" and tool:FindFirstChild("CombatScript")) then
                Humanoid:EquipTool(tool)
                return tool
            end
        end
    end
    return Character:FindFirstChildOfClass("Tool")
end

-- [[ Fast Attack M1 ]] --
local function FastAttack()
    if not Settings.FastAttack then return end
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))
    
    local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
    if net and net:FindFirstChild("RegisterAttack") then
        net.RegisterAttack:FireServer(0)
    end
end

-- [[ Movement Tween with Dynamic Obstacle Clipping ]] --
local function TweenToPosition(targetCFrame)
    if not RootPart then return end
    local dist = (RootPart.Position - targetCFrame.Position).Magnitude
    local time = dist / Settings.TweenSpeed
    
    if CurrentTween then CurrentTween:Cancel() end
    
    local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)
    CurrentTween = TweenService:Create(RootPart, tweenInfo, {CFrame = targetCFrame})
    
    for _, part in ipairs(Character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.Velocity = Vector3.new(0, 0, 0)
        end
    end
    
    CurrentTween:Play()
end

-- [[ Execute Full Skill & Weapon Combo ]] --
local function ExecuteCombo(targetChar)
    local tHRP = targetChar:FindFirstChild("HumanoidRootPart")
    local tHum = targetChar:FindFirstChild("Humanoid")
    if not tHRP or not tHum or tHum.Health <= 0 then return end

    EnsureHaki()

    for _, category in ipairs(Settings.WeaponSequence) do
        if not Settings.AutoBounty or not IsValidPvPTarget(CurrentTarget) then break end
        
        EquipWeapon(category)
        task.wait(0.08)

        -- Lock orientation directly onto target
        RootPart.CFrame = CFrame.new(RootPart.Position, Vector3.new(tHRP.Position.X, RootPart.Position.Y, tHRP.Position.Z))

        -- M1 Spam Burst
        for i = 1, 3 do
            FastAttack()
            task.wait(0.06)
        end

        -- Cast Skills
        for _, key in ipairs(Settings.Skills) do
            if not IsValidPvPTarget(CurrentTarget) then break end
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
            task.wait(0.1)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
            task.wait(0.25)
        end
    end
end

-- [[ Main Combat Engine ]] --
task.spawn(function()
    while true do
        task.wait(0.05)
        
        if Settings.AutoBounty then
            -- Validate current target real-time
            if not IsValidPvPTarget(CurrentTarget) then
                if CurrentTarget then
                    BlacklistCurrentTarget("Entered SafeZone or PvP Disabled")
                end
                CurrentTarget = AcquireNextTarget()
                TargetLockTime = tick()
                TargetInitialHealth = CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") and CurrentTarget.Character.Humanoid.Health or nil
            end

            -- Combat Execution & Health Stall Detection
            if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
                local tHRP = CurrentTarget.Character.HumanoidRootPart
                local tHum = CurrentTarget.Character:FindFirstChild("Humanoid")
                
                -- Check if target is in safe zone mid-flight
                if IsPositionInSafeZone(tHRP.Position) then
                    BlacklistCurrentTarget("Target ran into SafeZone")
                else
                    -- Move to target
                    local targetPos = tHRP.CFrame * CFrame.new(0, 0, Settings.AttackDistance)
                    TweenToPosition(targetPos)
                    
                    -- Damage Stall Checker (Anti-Invincible / Exploit Desync)
                    if Settings.SkipStuckTargets and TargetInitialHealth and (tick() - TargetLockTime > Settings.TargetTimeout) then
                        if tHum and tHum.Health >= TargetInitialHealth then
                            BlacklistCurrentTarget("Health not decreasing (Invulnerable/Glitch)")
                        else
                            TargetInitialHealth = tHum and tHum.Health or nil
                            TargetLockTime = tick()
                        end
                    end
                    
                    -- Trigger Attacks when in Range
                    if (RootPart.Position - tHRP.Position).Magnitude <= 15 then
                        ExecuteCombo(CurrentTarget.Character)
                    end
                end
            end
        end
    end
end)


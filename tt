-- [[ Master Configuration ]] --
local Config = {
    Enabled = false,
    TargetMode = "Auto",     -- "Manual" (สั่งวาร์ปตัวไหนไปตัวนั้น 100%) หรือ "Auto" (ล่าเฉพาะคนมีค่าหัว)
    SelectedPlayer = nil,
    MinBountyLevel = 20,
    OverheadDistance = 11,   -- ระยะลอยเหนือหัว (studs)
    FastAttack = true,
    AutoHaki = true,
    AutoPvP = true,
    SkillSpam = true,
    Skills = {"Z", "X", "C", "V"},
    Weapons = {"Melee", "Sword", "Blox Fruit", "Gun"},
    WeaponSwitchDelay = 0.5
}

local CurrentTarget = nil
local CombatFramework = nil
local ActiveController = nil
local LastWeaponSwitch = 0
local CurrentWeaponIndex = 1

-- Remotes
local Remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
local CommF = Remotes and Remotes:WaitForChild("CommF_", 5)
local NetModule = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
local RegisterAttack = NetModule and (NetModule:FindFirstChild("RegisterAttack") or NetModule:FindFirstChild("RE/RegisterAttack"))
local RegisterHit = NetModule and (NetModule:FindFirstChild("RegisterHit") or NetModule:FindFirstChild("RE/RegisterHit"))

-- [[ Helper: Level Parser ]] --
local function GetPlayerLevel(player)
    if not player then return 0 end
    local data = player:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") then
        return tonumber(data.Level.Value) or 0
    end
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats and leaderstats:FindFirstChild("Level") then
        return tonumber(leaderstats.Level.Value) or 0
    end
    local attr = player:GetAttribute("Level")
    if attr then return tonumber(attr) or 0 end
    return 0
end

-- [[ Helper: HP Parser ]] --
local function GetPlayerHealth(player)
    if player and player.Character and player.Character:FindFirstChild("Humanoid") then
        local hum = player.Character.Humanoid
        return math.floor(hum.Health), math.floor(hum.MaxHealth)
    end
    return 0, 0
end

-- [[ Helper: Distance Parser ]] --
local function GetDistanceToPlayer(player)
    if RootPart and player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        return math.floor((RootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude)
    end
    return 999999
end

-- [[ Helper: Check if PvP is Active on Target ]] --
local function IsPvPActive(player)
    if not player or not player.Character then return false end
    local char = player.Character
    if char:FindFirstChild("PvPDisabled") or player:FindFirstChild("PvPDisabled") then
        return false
    end
    if char:FindFirstChildOfClass("ForceField") then
        return false
    end
    if char:GetAttribute("PvPDisabled") == true or player:GetAttribute("PvPDisabled") == true then
        return false
    end
    return true
end

-- [[ Anti-Fall & Anti-Bug Physics Freeze ]] --
RunService.Stepped:Connect(function()
    if Config.Enabled and Character and RootPart then
        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        -- ล็อคความเร็วฟิสิกส์ให้เป็น 0 ตลอดเวลา ป้องกันการตกแมพหรือเด้งถอยหลัง
        RootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        RootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end
end)

LocalPlayer.CharacterAdded:Connect(function(char)
    Character = char
    RootPart = char:WaitForChild("HumanoidRootPart")
    Humanoid = char:WaitForChild("Humanoid")
    task.wait(0.3)
    SetupCombatHooks()
end)

function SetupCombatHooks()
    pcall(function()
        local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
        if playerScripts and playerScripts:FindFirstChild("CombatFramework") then
            CombatFramework = require(playerScripts.CombatFramework)
            ActiveController = CombatFramework.activeController
        end
    end)
end
SetupCombatHooks()

-- [[ Auto Enable PvP & Buso Haki ]] --
local function EnsurePvPAndHaki()
    if not Character then return end
    pcall(function()
        if Config.AutoPvP and CommF then
            if Character:FindFirstChild("PvPDisabled") then
                CommF:InvokeServer("EnablePvp")
            end
        end
        if Config.AutoHaki and CommF then
            if not Character:FindFirstChild("HasBuso") then
                CommF:InvokeServer("Buso")
            end
        end
    end)
end

-- [[ Auto Target Selector: Only Bounty-Eligible & PvP Active ]] --
local function GetBestBountyTarget()
    local best = nil
    local shortestDist = math.huge
    local myLevel = GetPlayerLevel(LocalPlayer)

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
            local hum = p.Character.Humanoid
            local hrp = p.Character.HumanoidRootPart
            local pLevel = GetPlayerLevel(p)

            if hum.Health > 0 and IsPvPActive(p) and pLevel >= Config.MinBountyLevel then
                local isBountyEligible = true
                if myLevel > 100 and pLevel < (myLevel - 350) and pLevel < 2000 then
                    isBountyEligible = false
                end

                if isBountyEligible then
                    local dist = (RootPart.Position - hrp.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        best = p
                    end
                end
            end
        end
    end

    return best
end

-- [[ Weapon Switcher ]] --
local function SwitchWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack or not Character or not Humanoid then return end

    local category = Config.Weapons[CurrentWeaponIndex]
    local targetTool = nil

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local tType = tool:GetAttribute("WeaponType") or tool.ToolTip
            if tType == category or tool.Name:lower():find(category:lower()) or (category == "Melee" and (tool:FindFirstChild("CombatScript") or tool.ToolTip == "Melee")) then
                targetTool = tool
                break
            end
        end
    end

    if targetTool then
        Humanoid:EquipTool(targetTool)
    end

    CurrentWeaponIndex = (CurrentWeaponIndex % #Config.Weapons) + 1
end

-- [[ Fast Attack Engine ]] --
local function ExecuteFastAttack(targetHRP)
    if not Config.FastAttack or not targetHRP then return end

    pcall(function()
        if not ActiveController then SetupCombatHooks() end
        if ActiveController then
            ActiveController.timeToNextAttack = 0
            ActiveController.attacking = false
            ActiveController.blocking = false
            ActiveController.hitboxMagnitude = 100
            ActiveController.increment = 3
            if ActiveController.attack then ActiveController:attack() end
            if ActiveController.bladeHit then ActiveController.bladeHit(targetHRP, {targetHRP}) end
        end
    end)

    pcall(function()
        if RegisterAttack then RegisterAttack:FireServer(0) end
        if RegisterHit then RegisterHit:FireServer(targetHRP, {{targetHRP.Parent, targetHRP}}) end
    end)

    local currentTool = Character:FindFirstChildOfClass("Tool")
    if currentTool then currentTool:Activate() end
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))
end

-- [[ Skill Cast Engine ]] --
local function CastSkills(targetHRP, targetHum)
    if not Config.SkillSpam or not targetHRP or targetHum.Health <= 0 then return end
    pcall(function()
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHRP.Position)
    end)

    for _, key in ipairs(Config.Skills) do
        if not CurrentTarget or targetHum.Health <= 0 then break end
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
        task.wait(0.02)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
        task.wait(0.03)
    end
end

-- [[ Instant Zero-Bug Teleport (Overhead Snap CFrame) ]] --
local function InstantTeleportToTarget(targetHRP)
    local targetOverheadPos = targetHRP.Position + Vector3.new(0, Config.OverheadDistance, 0)
    local targetCF = CFrame.new(targetOverheadPos, targetHRP.Position) * CFrame.Angles(math.rad(-90), 0, 0)

    -- วาร์ปปักหัวทันทีแบบไร้แรงเฉื่อย
    RootPart.CFrame = targetCF
    RootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    RootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
end

-- [[ Master Combat & Instant TP Loop ]] --
task.spawn(function()
    while true do
        task.wait(0.015)
        
        if Config.Enabled then
            EnsurePvPAndHaki()

            -- ตรวจสอบเป้าหมายตามโหมด
            if Config.TargetMode == "Manual" and Config.SelectedPlayer then
                local p = Config.SelectedPlayer
                if p and p.Parent and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    CurrentTarget = p
                else
                    CurrentTarget = nil
                end
            else
                if not CurrentTarget 
                    or not CurrentTarget.Parent 
                    or not CurrentTarget.Character 
                    or not CurrentTarget.Character:FindFirstChild("HumanoidRootPart") 
                    or not CurrentTarget.Character:FindFirstChild("Humanoid")
                    or CurrentTarget.Character.Humanoid.Health <= 0 then
                    
                    CurrentTarget = GetBestBountyTarget()
                end
            end

            -- ทำการวาร์ปและโจมตี
            if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
                local tHRP = CurrentTarget.Character.HumanoidRootPart
                local tHum = CurrentTarget.Character.Humanoid

                if tHum.Health > 0 then
                    -- วาร์ปปักหัวทันที (Zero Delay TP)
                    InstantTeleportToTarget(tHRP)

                    -- สลับอาวุธ
                    if tick() - LastWeaponSwitch >= Config.WeaponSwitchDelay then
                        SwitchWeapon()
                        LastWeaponSwitch = tick()
                    end

                    -- ฟันรัวๆ + สกิล
                    ExecuteFastAttack(tHRP)
                    CastSkills(tHRP, tHum)
                else
                    CurrentTarget = nil
                end
            end
        else
            CurrentTarget = nil
        end
    end
end)


    ScreenGui.ResetOnSpawn = false
    
    local success, coreGui = pcall(function() return game:GetService("CoreGui") end)
    ScreenGui.Parent = success and coreGui or LocalPlayer:WaitForChild("PlayerGui")

    local Frame = Instance.new("Frame", ScreenGui)
    Frame.Size = UDim2.new(0, 300, 0, 240)
    Frame.Position = UDim2.new(0.5, -150, 0.25, 0)
    Frame.BackgroundColor3 = Color3.fromRGB(16, 16, 22)
    Frame.BorderSizePixel = 0
    Frame.Active = true
    Frame.Draggable = true

    local Corner = Instance.new("UICorner", Frame)
    Corner.CornerRadius = UDim.new(0, 10)

    local Stroke = Instance.new("UIStroke", Frame)
    Stroke.Color = Color3.fromRGB(80, 80, 120)
    Stroke.Thickness = 1.5

    local Title = Instance.new("TextLabel", Frame)
    Title.Size = UDim2.new(1, 0, 0, 38)
    Title.Text = "SINGLE-TARGET BOUNTY HUNTER"
    Title.TextColor3 = Color3.fromRGB(240, 240, 255)
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 13
    Title.BackgroundTransparency = 1

    -- Main Toggle
    local ToggleBtn = Instance.new("TextButton", Frame)
    ToggleBtn.Size = UDim2.new(0.9, 0, 0, 42)
    ToggleBtn.Position = UDim2.new(0.05, 0, 0, 45)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToggleBtn.Font = Enum.Font.GothamBold
    ToggleBtn.TextSize = 14
    ToggleBtn.Text = "AUTO BOUNTY: OFF"
    local tCorner = Instance.new("UICorner", ToggleBtn)
    tCorner.CornerRadius = UDim.new(0, 6)

    ToggleBtn.MouseButton1Click:Connect(function()
        Config.Enabled = not Config.Enabled
        ToggleBtn.BackgroundColor3 = Config.Enabled and Color3.fromRGB(45, 140, 80) or Color3.fromRGB(35, 35, 45)
        ToggleBtn.Text = "AUTO BOUNTY: " .. (Config.Enabled and "ACTIVE" or "OFF")
        if not Config.Enabled then
            DropTarget("User Toggled Off")
        end
    end)

    -- Status Card
    local Status = Instance.new("TextLabel", Frame)
    Status.Size = UDim2.new(0.9, 0, 0, 120)
    Status.Position = UDim2.new(0.05, 0, 0, 98)
    Status.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    Status.TextColor3 = Color3.fromRGB(190, 210, 255)
    Status.Font = Enum.Font.Gotham
    Status.TextSize = 12
    Status.TextWrapped = true
    Status.Text = "State: IDLE\nTarget: None"
    local sCorner = Instance.new("UICorner", Status)
    sCorner.CornerRadius = UDim.new(0, 6)

    -- Live UI Updater
    task.spawn(function()
        while ScreenGui.Parent do
            task.wait(0.2)
            if not Config.Enabled then
                Status.Text = "State: IDLE (Disabled)\nTarget: None"
            elseif LockedTarget and LockedTarget.Character and LockedTarget.Character:FindFirstChild("Humanoid") then
                local hp = math.floor(LockedTarget.Character.Humanoid.Health)
                local maxHp = math.floor(LockedTarget.Character.Humanoid.MaxHealth)
                Status.Text = string.format("State: [%s]\nLocked Target: %s\nHealth: %d / %d\nDist: %d studs", 
                    CurrentState, LockedTarget.Name, hp, maxHp, 
                    math.floor((RootPart.Position - LockedTarget.Character.HumanoidRootPart.Position).Magnitude))
            else
                Status.Text = string.format("State: [%s]\nScanning for valid PvP player outside SafeZone...", CurrentState)
            end
        end
    end)
end

BuildUI()

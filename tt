-- [[ Dynamic SafeZone Scanner ]] --
local ScannedSafeZones = {}
local function RescanWorkspaceSafeZones()
    table.clear(ScannedSafeZones)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if (obj.Name:lower():find("safezone") or obj.Name:lower():find("safe_zone")) and obj:IsA("BasePart") then
            table.insert(ScannedSafeZones, obj)
        end
    end
end
RescanWorkspaceSafeZones()

-- [[ TIER 2: Comprehensive SafeZone & Invulnerability Checker ]] --
local function IsPositionInAnySafeZone(position)
    -- 1. Check Hardcoded Database
    for _, sz in ipairs(KnownSafeZones) do
        if (position - sz.Pos).Magnitude <= sz.Radius then
            return true
        end
    end
    
    -- 2. Check Dynamic Workspace Parts
    for _, part in ipairs(ScannedSafeZones) do
        if part and part.Parent then
            local rel = part.CFrame:PointToObjectSpace(position)
            local half = part.Size / 2
            if math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z then
                return true
            end
            if (part.Position - position).Magnitude <= (part.Size.Magnitude / 2) then
                return true
            end
        end
    end
    return false
end

local function IsValidTarget(player)
    if not player or player == LocalPlayer or not player.Parent then return false end
    
    -- Blacklist Filter
    if Blacklist[player] and tick() < Blacklist[player] then return false end

    local char = player.Character
    if not char then return false end

    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return false end

    -- Safezone Shields / Forcefield / Tags
    if char:FindFirstChildOfClass("ForceField") or char:FindFirstChild("SafeZoneShield") or char:FindFirstChild("PvPDisabled") then
        return false
    end

    -- PvP Value Check
    local data = player:FindFirstChild("Data")
    if data and data:FindFirstChild("PvP") and data.PvP.Value == false then
        return false
    end

    -- Position Checks
    if IsPositionInAnySafeZone(hrp.Position) then
        return false
    end

    return true
end

-- [[ Target Blacklister (Instant Drop) ]] --
local function DropAndBlacklist(targetPlayer, reason)
    if targetPlayer then
        Blacklist[targetPlayer] = tick() + Config.BlacklistDuration
        print(string.format("[Watchdog] ❌ Target Dropped: %s | Reason: %s (Blacklisted for %ds)", targetPlayer.Name, reason or "SafeZone/Immune", Config.BlacklistDuration))
    end
    CurrentTarget = nil
    TargetHealthTracker = nil
    AttackStartTimestamp = 0
end

-- [[ Physics Anchor ]] --
local function MaintainAnchor()
    if not RootPart then return end
    if not BodyVel or BodyVel.Parent ~= RootPart then
        if BodyVel then BodyVel:Destroy() end
        BodyVel = Instance.new("BodyVelocity")
        BodyVel.Name = "OnyxAnchor"
        BodyVel.Velocity = Vector3.new(0, 0, 0)
        BodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        BodyVel.P = 1500
        BodyVel.Parent = RootPart
    end
end

local function ClearAnchor()
    if BodyVel then
        BodyVel:Destroy()
        BodyVel = nil
    end
end


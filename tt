-- [[ Blox Fruits Stable Overhead Bounty Hunter v69 ]] --
-- Architecture: Overhead Hover (Y+11), BodyVelocity Zero-Inertia, Advanced Combat Hook (bladeHit + RegisterHit), Auto-Aim Skill Engine, Auto PvP Unlock & Buso Haki

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local VirtualUser = game:GetService("VirtualUser")
local VirtualInputManager = game:GetService("VirtualInputManager")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera
local Mouse = LocalPlayer:GetMouse()

local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")
local Humanoid = Character:WaitForChild("Humanoid")

-- [[ Master Configuration ]] --
local Config = {
    Enabled = false,
    OverheadDistance = 11,   -- Studs directly above target head
    FlySpeed = 350,
    FastAttack = true,
    AutoHaki = true,
    AutoPvP = true,          -- Auto unlock PvP disabled state
    SkillSpam = true,
    Skills = {"Z", "X", "C", "V"},
    Weapons = {"Melee", "Sword", "Blox Fruit", "Gun"},
    WeaponSwitchDelay = 1.2
}

local CurrentTarget = nil
local BodyVel = nil
local CombatFramework = nil
local ActiveController = nil
local LastWeaponSwitch = 0
local CurrentWeaponIndex = 1

-- [[ Remote References ]] --
local Remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
local CommF = Remotes and Remotes:WaitForChild("CommF_", 5)
local NetModule = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
local RegisterAttack = NetModule and (NetModule:FindFirstChild("RegisterAttack") or NetModule:FindFirstChild("RE/RegisterAttack"))
local RegisterHit = NetModule and (NetModule:FindFirstChild("RegisterHit") or NetModule:FindFirstChild("RE/RegisterHit"))

-- [[ Physics Anchor & Desync Prevention ]] --
local function EnsurePhysicsAnchor()
    if not RootPart then return end
    if not BodyVel or BodyVel.Parent ~= RootPart then
        if BodyVel then BodyVel:Destroy() end
        BodyVel = Instance.new("BodyVelocity")
        BodyVel.Name = "OnyxAnchor"
        BodyVel.Velocity = Vector3.new(0, 0, 0)
        BodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        BodyVel.P = 1500
        BodyVel.Parent = RootPart
    end
end

local function RemovePhysicsAnchor()
    if BodyVel then
        BodyVel:Destroy()
        BodyVel = nil
    end
end

-- [[ Stepped Noclip & Velocity Lock ]] --
RunService.Stepped:Connect(function()
    if Config.Enabled and Character then
        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        if RootPart then
            RootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            RootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end
end)

-- [[ Character Lifecycle ]] --
LocalPlayer.CharacterAdded:Connect(function(char)
    Character = char
    RootPart = char:WaitForChild("HumanoidRootPart")
    Humanoid = char:WaitForChild("Humanoid")
    task.wait(0.5)
    EnsurePhysicsAnchor()
    SetupCombatHooks()
end)

-- [[ Combat Framework Hook ]] --
function SetupCombatHooks()
    pcall(function()
        local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
        if playerScripts and playerScripts:FindFirstChild("CombatFramework") then
            CombatFramework = require(playerScripts.CombatFramework)
            ActiveController = CombatFramework.activeController
        end
    end)
end
SetupCombatHooks()

-- [[ Auto Enable PvP System ]] --
local function EnsurePvPEnabled()
    if not Config.AutoPvP then return end
    pcall(function()
        if Character:FindFirstChild("PvPDisabled") or (LocalPlayer.PlayerGui:FindFirstChild("Main") and LocalPlayer.PlayerGui.Main:FindFirstChild("Pvp") and LocalPlayer.PlayerGui.Main.Pvp.Visible) then
            if CommF then
                CommF:InvokeServer("EnablePvp")
            end
        end
    end)
end

-- [[ Auto Buso Haki System ]] --
local function CheckHaki()
    if not Config.AutoHaki or not Character then return end
    pcall(function()
        if not Character:FindFirstChild("HasBuso") then
            if CommF then
                CommF:InvokeServer("Buso")
            end
        end
    end)
end

-- [[ SafeZone Cache ]] --
local SafeZones = {}
for _, obj in ipairs(Workspace:GetDescendants()) do
    if (obj.Name == "SafeZone" or obj.Name:lower():find("safezone")) and obj:IsA("BasePart") then
        table.insert(SafeZones, obj)
    end
end

local function IsInSafeZone(pos)
    for _, zone in ipairs(SafeZones) do
        if zone and zone.Parent then
            local rel = zone.CFrame:PointToObjectSpace(pos)
            local sz = zone.Size / 2
            if math.abs(rel.X) <= sz.X and math.abs(rel.Y) <= sz.Y and math.abs(rel.Z) <= sz.Z then
                return true
            end
        end
    end
    return false
end

-- [[ Target Selector ]] --
local function GetBestTarget()
    local best = nil
    local shortest = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
            local char = p.Character
            local hum = char.Humanoid
            local hrp = char.HumanoidRootPart

            if hum.Health > 0 and not char:FindFirstChildOfClass("ForceField") and not char:FindFirstChild("PvPDisabled") then
                if not IsInSafeZone(hrp.Position) then
                    local dist = (RootPart.Position - hrp.Position).Magnitude
                    if dist < shortest then
                        shortest = dist
                        best = p
                    end
                end
            end
        end
    end
    return best
end

-- [[ Smart Weapon Rotator ]] --
local function SwitchToNextWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack or not Character or not Humanoid then return end

    local category = Config.Weapons[CurrentWeaponIndex]
    local targetTool = nil

    -- Find matching weapon tool in Backpack or Character
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local tType = tool:GetAttribute("WeaponType") or tool.ToolTip
            if tType == category or tool.Name:lower():find(category:lower()) or (category == "Melee" and (tool:FindFirstChild("CombatScript") or tool.ToolTip == "Melee")) then
                targetTool = tool
                break
            end
        end
    end

    if targetTool then
        Humanoid:EquipTool(targetTool)
    end

    CurrentWeaponIndex = (CurrentWeaponIndex % #Config.Weapons) + 1
end

-- [[ Real Fast Attack & Packet Hit Registration Engine ]] --
local function ExecuteFastAttack(targetHRP)
    if not Config.FastAttack or not targetHRP then return end

    -- 1. Direct BladeHit / Hitbox Bypass
    pcall(function()
        if not ActiveController then
            SetupCombatHooks()
        end
        if ActiveController then
            ActiveController.timeToNextAttack = 0
            ActiveController.attacking = false
            ActiveController.blocking = false
            ActiveController.hitboxMagnitude = 80
            ActiveController.increment = 3
            if ActiveController.attack then
                ActiveController:attack()
            end
            if ActiveController.bladeHit then
                ActiveController.bladeHit(targetHRP, {targetHRP})
            end
        end
    end)

    -- 2. Net Remote Attack Registration
    pcall(function()
        if RegisterAttack then
            RegisterAttack:FireServer(0)
        end
        if RegisterHit then
            local hitTable = {{targetHRP.Parent, targetHRP}}
            RegisterHit:FireServer(targetHRP, hitTable)
        end
    end)

    -- 3. Tool Click Emulation & Hardware Input Fallback
    local currentTool = Character:FindFirstChildOfClass("Tool")
    if currentTool then
        currentTool:Activate()
    end
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))
end

-- [[ Direct Camera & Skill Vector Aim ]] --
local function AimAtTarget(targetPos)
    pcall(function()
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
    end)
end

-- [[ Skill Execution Engine ]] --
local function FireSkills(targetHRP, targetHum)
    if not Config.SkillSpam or not targetHRP or targetHum.Health <= 0 then return end

    AimAtTarget(targetHRP.Position)
    for _, key in ipairs(Config.Skills) do
        if not CurrentTarget or targetHum.Health <= 0 then break end
        
        AimAtTarget(targetHRP.Position)
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
        task.wait(0.08)
    end
end

-- [[ Overhead Positioning Engine ]] --
local function HoverOverhead(targetHRP)
    EnsurePhysicsAnchor()
    
    local overheadCFrame = CFrame.new(targetHRP.Position + Vector3.new(0, Config.OverheadDistance, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
    local currentPos = RootPart.Position
    local targetPos = overheadCFrame.Position
    local dist = (currentPos - targetPos).Magnitude

    if dist > 120 then
        RootPart.CFrame = CFrame.new(currentPos:Lerp(targetPos, (Config.FlySpeed * 0.03) / dist))
    else
        RootPart.CFrame = overheadCFrame
    end
end

-- [[ Master Combat Loop ]] --
task.spawn(function()
    while true do
        task.wait(0.015)
        
        if Config.Enabled then
            EnsurePvPEnabled()
            CheckHaki()

            -- Validate Target
            if not CurrentTarget 
                or not CurrentTarget.Character 
                or not CurrentTarget.Character:FindFirstChild("Humanoid") 
                or not CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
                or CurrentTarget.Character.Humanoid.Health <= 0 
                or CurrentTarget.Character:FindFirstChild("PvPDisabled")
                or IsInSafeZone(CurrentTarget.Character.HumanoidRootPart.Position) then
                CurrentTarget = GetBestTarget()
            end

            if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
                local tHRP = CurrentTarget.Character.HumanoidRootPart
                local tHum = CurrentTarget.Character.Humanoid

                -- Lock Position Overhead
                HoverOverhead(tHRP)

                -- Weapon Switch Timer
                if tick() - LastWeaponSwitch >= Config.WeaponSwitchDelay then
                    SwitchToNextWeapon()
                    LastWeaponSwitch = tick()
                end

                -- Range Check for Attack Delivery
                local dist = (RootPart.Position - tHRP.Position).Magnitude
                if dist <= (Config.OverheadDistance + 15) then
                    -- Execute M1 Fast Attack
                    ExecuteFastAttack(tHRP)

                    -- Cast Aimed Skills
                    FireSkills(tHRP, tHum)
                end
            end
        else
            RemovePhysicsAnchor()
        end
    end
end)

